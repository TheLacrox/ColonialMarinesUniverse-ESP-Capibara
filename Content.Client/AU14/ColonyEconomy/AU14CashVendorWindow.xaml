<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:loc="clr-namespace:Content.Client._CMU14.Localizations"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    MinHeight="300" MinWidth="320">
    <BoxContainer Orientation="Vertical">
        <!-- Cash display header -->
        <BoxContainer Orientation="Horizontal" Margin="8 4">
            <Label Text="{loc:CMULoc 'cmu-colony-economy-credit-label', 'Credit: '}" StyleClasses="LabelKeyText" />
            <Label Name="InsertedCashLabel" Access="Public" Text="$0" StyleClasses="LabelKeyText" HorizontalExpand="True" />
            <Button Name="ScanIdBtn" Access="Public" Text="{loc:CMULoc 'cmu-colony-economy-scan-id', 'Scan ID'}" MinWidth="80" Visible="False" />
            <Button Name="ReturnChangeBtn" Access="Public" Text="{loc:CMULoc 'cmu-colony-economy-return-change', 'Return Change'}" MinWidth="120" />
        </BoxContainer>
        <!-- Department budget row (visible when dept mode active) -->
        <BoxContainer Name="DeptBudgetRow" Access="Public" Orientation="Horizontal" Margin="8 2" Visible="False">
            <Label Text="{loc:CMULoc 'cmu-colony-economy-department-budget-short-label', 'Dept Budget: '}" StyleClasses="LabelKeyText" />
            <Label Name="DeptBudgetLabel" Access="Public" Text="$0" StyleClasses="LabelKeyText" HorizontalExpand="True" />
        </BoxContainer>
        <PanelContainer StyleClasses="LowDivider" />
        <!-- Search bar -->
        <LineEdit Name="SearchBar" Access="Public" PlaceHolder="{loc:CMULoc 'cmu-colony-economy-search-placeholder', 'Search...'}" HorizontalExpand="True" Margin="4 4" />
        <!-- Item list -->
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False" Margin="4 0">
            <BoxContainer Name="ItemList" Access="Public" Orientation="Vertical" SeparationOverride="2" />
        </ScrollContainer>
        <!-- Footer -->
        <BoxContainer Orientation="Vertical">
            <PanelContainer StyleClasses="LowDivider" />
            <BoxContainer Orientation="Horizontal" Margin="10 2 5 0" VerticalAlignment="Bottom">
                <Label Text="{loc:CMULoc 'cmu-colony-economy-insert-cash-select-item', 'Insert cash, then select item.'}" StyleClasses="WindowFooterText" />
                <Label Name="TaxFooterLabel" Access="Public" Text="{loc:CMULoc 'cmu-colony-economy-prices-include-tax', 'Prices incl. tax'}" StyleClasses="WindowFooterText"
                       HorizontalAlignment="Right" HorizontalExpand="True" Margin="0 0 5 0" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
