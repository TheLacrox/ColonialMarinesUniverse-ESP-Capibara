<controls:AU14ShopkeeperVendorWindow
    xmlns="https://spacestation14.io"
    xmlns:loc="clr-namespace:Content.Client._CMU14.Localizations"
    xmlns:controls="clr-namespace:Content.Client.AU14.ColonyEconomy"
    Title="{loc:CMULoc 'cmu-colony-economy-shop-title', 'Shop'}" MinSize="520 480">
    <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="8">
        <Label Name="InsertedCashLabel" Access="Public" Text="{loc:CMULoc 'cmu-colony-economy-inserted-cash-placeholder', 'Inserted: $0'}"
               StyleClasses="LabelHeading" Margin="0 4" />
        <Label Text="{loc:CMULoc 'cmu-colony-economy-shop-instruction', 'Insert cash into the slot, then buy an item.'}"
               StyleClasses="LabelSubText" Margin="0 2" />
        <Label Name="SalesTaxLabel" Access="Public" Text="" StyleClasses="LabelSubText" Margin="0 2" />
        <Label Text="{loc:CMULoc 'cmu-colony-economy-items-for-sale-heading', '-- Items For Sale --'}" Margin="0 4" />
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False" MinSize="0 220">
            <BoxContainer Name="ItemList" Access="Public" Orientation="Vertical" SeparationOverride="2" />
        </ScrollContainer>
        <Button Name="ReturnChangeBtn" Access="Public" Text="{loc:CMULoc 'cmu-colony-economy-return-change', 'Return Change'}"
                HorizontalExpand="True" Margin="0 4" />
        <!-- Manage section: only visible for shopkeepers -->
        <BoxContainer Name="ManageSection" Access="Public" Orientation="Vertical" SeparationOverride="4" Visible="False">
            <Label Text="{loc:CMULoc 'cmu-colony-economy-manage-stock-heading', '-- Manage Stock --'}" Margin="0 6" StyleClasses="LabelHeading" />
            <Label Text="{loc:CMULoc 'cmu-colony-economy-manage-stock-instruction', 'Use an item on this machine to add stock. Edit default price here.'}" StyleClasses="LabelSubText" Margin="0 2" />
            <Label Text="{loc:CMULoc 'cmu-colony-economy-default-price-description', 'Default price determines the price of newly inserted stock.'}" StyleClasses="LabelSubText" Margin="0 2" />
            <BoxContainer Orientation="Horizontal" Access="Public">
                <Label Text ="{loc:CMULoc 'cmu-colony-economy-default-price-label', 'Default Price: '}" StyleClasses="LabelSubText"/>
                <LineEdit Name="DefaultPriceLineEdit" HorizontalExpand="True"></LineEdit>
                <Button Name="SaveDefaultPriceBtn" Text="{loc:CMULoc 'cmu-colony-economy-save', 'Save'}" HorizontalExpand="True" Margin="0 4"/>
            </BoxContainer>
            <Label Text="{loc:CMULoc 'cmu-colony-economy-edit-name-price', 'Edit name/price below.'}"
                   StyleClasses="LabelSubText" Margin="0 2" />
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False" MinSize="0 160">
                <BoxContainer Name="ManageList" Access="Public" Orientation="Vertical" SeparationOverride="4" />
            </ScrollContainer>
        </BoxContainer>
    </BoxContainer>
</controls:AU14ShopkeeperVendorWindow>
