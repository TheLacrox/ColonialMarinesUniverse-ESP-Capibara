<controls:AdminConsoleThirdPartyWindow
    xmlns="https://spacestation14.io"
    xmlns:loc="clr-namespace:Content.Client._CMU14.Localizations"
    xmlns:controls="clr-namespace:Content.Client.AU14.ColonyEconomy"
    Title="{loc:CMULoc 'cmu-colony-economy-admin-support-title', 'Call Third Party Support (Admin)'}" MinSize="400 300">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="8">
        <Label Name="BudgetLabel" Access="Public" Text="{loc:CMULoc 'cmu-colony-economy-colony-budget-placeholder', 'Colony Budget: $0'}"
               StyleClasses="LabelHeading" Margin="4 4" />
        <Label Text="{loc:CMULoc 'cmu-ambassador-third-party-available', 'Available Third Parties:'}" StyleClasses="LabelHeading" Margin="4 8" />
        <ItemList Name="ThirdPartyList" Access="Public" SelectMode="Single" HorizontalExpand="True" VerticalExpand="True" MinSize="0 120" Margin="4 4" />
        <Label Name="CostLabel" Access="Public" Text="{loc:CMULoc 'cmu-ambassador-third-party-cost-placeholder', 'Cost: $0'}" Margin="4 4" />
        <Button Name="CallBtn" Access="Public" Text="{loc:CMULoc 'cmu-ambassador-third-party-request-support', 'Request Support'}"
                HorizontalExpand="True" Margin="4 8" />
        <Label Name="StatusLabel" Access="Public" Text="" Margin="4 4" />
    </BoxContainer>
</controls:AdminConsoleThirdPartyWindow>

