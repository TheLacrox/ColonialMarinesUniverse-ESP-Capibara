<controls:DepartmentConsoleWindow
    xmlns="https://spacestation14.io"
    xmlns:loc="clr-namespace:Content.Client._CMU14.Localizations"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.AU14.ColonyEconomy"
    Title="{loc:CMULoc 'cmu-colony-economy-department-console-title', 'Department Console'}" MinSize="600 520">
    <TabContainer>
        <!-- Management Tab -->
        <BoxContainer Name="ManagementTab" Orientation="Vertical" SeparationOverride="4">
            <!-- Header -->
            <Label Name="DeptNameLabel" Access="Public" Text="{loc:CMULoc 'cmu-colony-economy-department-tab', 'Department'}" StyleClasses="LabelHeading" />
            <Label Name="DeptBudgetLabel" Access="Public" Text="{loc:CMULoc 'cmu-colony-economy-department-budget-placeholder', 'Department Budget: $0'}" />

            <!-- Withdraw from Department Budget -->
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Label Text="{loc:CMULoc 'cmu-colony-economy-withdraw-dollar-label', 'Withdraw: $'}" />
                <LineEdit Name="WithdrawAmountInput" Access="Public" PlaceHolder="{loc:CMULoc 'cmu-colony-economy-amount-placeholder', 'Amount'}"
                          HorizontalExpand="True" SizeFlagsStretchRatio="2" />
                <Button Name="WithdrawButton" Access="Public" Text="{loc:CMULoc 'cmu-colony-economy-withdraw-cash', 'Withdraw Cash'}" />
            </BoxContainer>

            <!-- Default Salary -->
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Label Text="{loc:CMULoc 'cmu-colony-economy-default-salary-label', 'Default Salary: $'}" />
                <LineEdit Name="DefaultSalaryInput" Access="Public" Text="50"
                          HorizontalExpand="True" SizeFlagsStretchRatio="2" />
                <Button Name="SetDefaultSalaryButton" Access="Public" Text="{loc:CMULoc 'cmu-colony-economy-set-default-salary', 'Set Default Salary'}" />
            </BoxContainer>

            <!-- Hire -->
            <Label Text="{loc:CMULoc 'cmu-colony-economy-hire-instruction', 'Use an ID card on the console to hire.'}" StyleClasses="LabelSubText"
                   Margin="0 2" />

            <!-- Employee List -->
            <Label Text="{loc:CMULoc 'cmu-colony-economy-employees-label', 'Employees:'}" StyleClasses="LabelSubText" />
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False" MinSize="0 180">
                <BoxContainer Name="EmployeeList" Access="Public" Orientation="Vertical" SeparationOverride="2" />
            </ScrollContainer>

            <!-- Department Announcement -->
            <Label Text="{loc:CMULoc 'cmu-colony-economy-department-announcement-label', 'Department Announcement:'}" StyleClasses="LabelSubText" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <LineEdit Name="AnnouncementInput" Access="Public" PlaceHolder="{loc:CMULoc 'cmu-colony-economy-announcement-placeholder', 'Type announcement...'}"
                          HorizontalExpand="True" SizeFlagsStretchRatio="3" />
                <Button Name="SendAnnouncementButton" Access="Public" Text="{loc:CMULoc 'cmu-colony-economy-send', 'Send'}" />
            </BoxContainer>
        </BoxContainer>

        <!-- Orders Tab -->
        <BoxContainer Name="OrdersTab" Orientation="Vertical" SeparationOverride="4">
            <Label Name="OrdersBudgetLabel" Access="Public" Text="{loc:CMULoc 'cmu-colony-economy-department-budget-placeholder', 'Department Budget: $0'}" StyleClasses="LabelHeading" />

            <!-- Reason / Deliver To fields -->
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Label Text="{loc:CMULoc 'cmu-colony-economy-reason-label', 'Reason:'}" MinWidth="70" />
                <LineEdit Name="OrderReasonInput" Access="Public" PlaceHolder="{loc:CMULoc 'cmu-colony-economy-order-reason-placeholder', 'Reason for order...'}"
                          HorizontalExpand="True" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Label Text="{loc:CMULoc 'cmu-colony-economy-deliver-to-label', 'Deliver to:'}" MinWidth="70" />
                <LineEdit Name="OrderDeliverToInput" Access="Public" PlaceHolder="{loc:CMULoc 'cmu-colony-economy-delivery-location-placeholder', 'Delivery location...'}"
                          HorizontalExpand="True" />
            </BoxContainer>

            <!-- Category buttons -->
            <Label Text="{loc:CMULoc 'cmu-colony-economy-categories-label', 'Categories:'}" StyleClasses="LabelSubText" />
            <ScrollContainer HScrollEnabled="True" VScrollEnabled="False" MinSize="0 36">
                <BoxContainer Name="OrderCategoryList" Access="Public" Orientation="Horizontal" SeparationOverride="4" />
            </ScrollContainer>

            <!-- Item list for selected category -->
            <Label Name="SelectedCategoryLabel" Access="Public" Text="{loc:CMULoc 'cmu-colony-economy-select-category', 'Select a category'}" StyleClasses="LabelSubText" />
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False" MinSize="0 200">
                <BoxContainer Name="OrderItemList" Access="Public" Orientation="Vertical" SeparationOverride="2" />
            </ScrollContainer>
        </BoxContainer>
    </TabContainer>
</controls:DepartmentConsoleWindow>
