<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               xmlns:loc="clr-namespace:Content.Client._CMU14.Localizations"
               Title="{Loc anprc-window-title}"
               MinWidth="400"
               MinHeight="420"
               SetSize="420 680">

  <PanelContainer>
    <PanelContainer.PanelOverride>
      <gfx:StyleBoxFlat BackgroundColor="#0E0F13" />
    </PanelContainer.PanelOverride>

    <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="5">

      <!-- Header -->
      <PanelContainer>
        <PanelContainer.PanelOverride>
          <gfx:StyleBoxFlat BackgroundColor="#181A20" BorderColor="#343846" BorderThickness="1" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Horizontal" Margin="6,4" SeparationOverride="6">
          <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="1">
            <Label Text="AN/PRC-117G" FontColorOverride="#C8D2E8" />
            <Label Text="{loc:CMULoc 'cmu-anprc-ui-subtitle', 'RTO MANPACK RELAY'}" FontColorOverride="#687A9A" />
          </BoxContainer>
          <BoxContainer Orientation="Vertical" SeparationOverride="1">
            <Label Name="HeaderPowerLabel" Text="{loc:CMULoc 'cmu-anprc-ui-power-placeholder', 'PWR: ---'}"  FontColorOverride="#687A9A" />
            <Label Name="HeaderLinkLabel"  Text="{loc:CMULoc 'cmu-anprc-ui-link-placeholder', 'LINK: ---'}" FontColorOverride="#687A9A" />
          </BoxContainer>
        </BoxContainer>
      </PanelContainer>

      <ScrollContainer VerticalExpand="True" SizeFlagsStretchRatio="3">
        <BoxContainer Orientation="Vertical" SeparationOverride="5">

          <!-- LCD -->
          <PanelContainer>
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#07130A" BorderColor="#245236" BorderThickness="2" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="8,6" SeparationOverride="3">
              <BoxContainer Orientation="Horizontal" SeparationOverride="5">
                <Label Name="LcdModeLabel"  Text="{loc:CMULoc 'cmu-anprc-ui-mode-fh', 'MODE: FH'}"  FontColorOverride="#4A7A55" />
                <Control HorizontalExpand="True" />
                <Label Name="TxIndicator"   Text="●"        FontColorOverride="#1E4A2E" />
                <Label Name="TxLabel"       Text="{loc:CMULoc 'cmu-anprc-ui-off', 'OFF'}"      FontColorOverride="#1E4A2E" />
                <Label Name="CryptoLabel"   Text="SEC"      FontColorOverride="#4A7A55" />
              </BoxContainer>
              <Label Name="FrequencyLabel"   Text="-- . ---"      FontColorOverride="#1E4A2E" />
              <Label Name="ChannelNameLabel" Text="{loc:CMULoc 'cmu-anprc-ui-no-net-loaded', 'NO NET LOADED'}" FontColorOverride="#1E4A2E" />
              <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Name="ChannelIdLabel" Text="{loc:CMULoc 'cmu-anprc-ui-channel-placeholder', 'CH: ---'}"   FontColorOverride="#4A7A55" HorizontalExpand="True" />
                <Label Name="BandLabel"      Text="{loc:CMULoc 'cmu-anprc-ui-band-placeholder', 'BAND: ---'}" FontColorOverride="#4A7A55" />
                <Label Name="WaveformLabel"  Text="{loc:CMULoc 'cmu-anprc-ui-waveform-placeholder', 'WF: ---'}"   FontColorOverride="#4A7A55" />
              </BoxContainer>
              <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="0,3,0,0">
                <Label Text="{loc:CMULoc 'cmu-anprc-ui-signal-short', 'SIG'}" FontColorOverride="#4A7A55" />
                <Label Name="SignalBarsLabel"  Text="░░░░░░░░" FontColorOverride="#1E4A2E" HorizontalExpand="True" />
                <Label Text="BAT" FontColorOverride="#4A7A55" />
                <Label Name="BatteryBarsLabel" Text="░░░░░░"   FontColorOverride="#1E4A2E" />
              </BoxContainer>
              <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Name="BitStatusLabel" Text="{loc:CMULoc 'cmu-anprc-ui-bit-offline', 'BIT: OFFLINE'}" FontColorOverride="#4A7A55" HorizontalExpand="True" />
                <Label Name="AntennaLabel"   Text="{loc:CMULoc 'cmu-anprc-ui-antenna-placeholder', 'ANT: ---'}"     FontColorOverride="#4A7A55" HorizontalExpand="True" />
                <Label Name="FaultLabel"     Text="{loc:CMULoc 'cmu-anprc-ui-fault-none', 'FAULT: NONE'}"  FontColorOverride="#687A9A" />
              </BoxContainer>
            </BoxContainer>
          </PanelContainer>

          <!-- Callsign -->
          <BoxContainer Orientation="Horizontal" Margin="2,1,2,0">
            <Label Text="{loc:CMULoc 'cmu-anprc-ui-callsign', 'CALLSIGN'}" FontColorOverride="#A9C3E8" HorizontalExpand="True" />
            <Label Name="CallsignDisplayLabel" Text="{loc:CMULoc 'cmu-anprc-ui-not-set', 'NOT SET'}" FontColorOverride="#687A9A" />
          </BoxContainer>
          <PanelContainer>
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#17181D" BorderColor="#3D4059" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <OptionButton Name="CallsignPresetButton" MinWidth="110" />
                <LineEdit Name="CallsignLineEdit"
                          HorizontalExpand="True"
                          PlaceHolder="{loc:CMULoc 'cmu-anprc-ui-callsign-placeholder', 'Max 16 chars (e.g. LIMA-6)'}" />
                <Button Name="CallsignSetButton" Text="{loc:CMULoc 'cmu-anprc-ui-set', 'SET'}" MinWidth="48" />
              </BoxContainer>
              <Label Text="{loc:CMULoc 'cmu-anprc-ui-callsign-help', 'Station override. Blank = your assigned callsign (AUTO). SET empty to clear.'}" FontColorOverride="#4A7A55" />
              <Button Name="DirectoryButton" Text="{loc:CMULoc 'cmu-anprc-ui-callsign-directory', 'CALLSIGN DIRECTORY'}" />
            </BoxContainer>
          </PanelContainer>

          <!-- Preset slots -->
          <BoxContainer Orientation="Horizontal" Margin="2,1,2,0">
            <Label Text="{loc:CMULoc 'cmu-anprc-ui-preset-nets', 'PRESET NETS'}" FontColorOverride="#A9C3E8" HorizontalExpand="True" />
            <Label Name="PresetSummaryLabel" Text="0/4" FontColorOverride="#687A9A" />
          </BoxContainer>

          <PanelContainer Name="PresetPanel">
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#17181D" BorderColor="#3D4059" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="5" SeparationOverride="4">
              <!-- Slot rows are added dynamically from code-behind -->
              <BoxContainer Name="SlotListContainer" Orientation="Vertical" SeparationOverride="3" />
              <!-- ADD button row -->
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="AddSlotButton" Text="{loc:CMULoc 'cmu-anprc-ui-add-net', '+ ADD NET'}" HorizontalExpand="True" />
              </BoxContainer>
              <Label Text="{loc:CMULoc 'cmu-anprc-ui-transmit-hint', ':r transmits on the selected net.'}" FontColorOverride="#4A7A55" />
            </BoxContainer>
          </PanelContainer>

          <!-- Add-slot panel (hidden by default) -->
          <PanelContainer Name="AddSlotPanel">
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#0E1A10" BorderColor="#245236" BorderThickness="2" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <Label Text="{loc:CMULoc 'cmu-anprc-ui-new-net-label', 'NEW NET LABEL:'}" FontColorOverride="#A9C3E8" />
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <LineEdit Name="AddSlotLabelEdit"
                          HorizontalExpand="True"
                          PlaceHolder="{loc:CMULoc 'cmu-anprc-ui-net-label-placeholder', 'Max 8 chars (e.g. CMD)'}" />
                <Button Name="AddSlotConfirmButton" Text="{loc:CMULoc 'cmu-anprc-ui-add', 'ADD'}"    MinWidth="48" />
                <Button Name="AddSlotCancelButton"  Text="{loc:CMULoc 'cmu-anprc-ui-cancel', 'CANCEL'}" MinWidth="60" />
              </BoxContainer>
            </BoxContainer>
          </PanelContainer>

          <!-- Slot entry panel (hidden by default) -->
          <PanelContainer Name="SlotEntryPanel">
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#0E1A10" BorderColor="#245236" BorderThickness="2" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <Label Name="SlotEntryHeaderLabel" Text="{loc:CMULoc 'cmu-anprc-ui-tune-slot', 'TUNE SLOT:'}" FontColorOverride="#A9C3E8" />

              <!-- Tab buttons -->
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="EntryTabFreqButton" Text="{loc:CMULoc 'cmu-anprc-ui-frequency-short', 'FREQ'}"  HorizontalExpand="True" />
                <Button Name="EntryTabNetButton"  Text="{loc:CMULoc 'cmu-anprc-ui-net', 'NET'}"   HorizontalExpand="True" />
                <Button Name="EntryTabClearButton" Text="{loc:CMULoc 'cmu-anprc-ui-clear', 'CLEAR'}" HorizontalExpand="True" />
              </BoxContainer>

              <!-- FREQ tab content -->
              <BoxContainer Name="EntryFreqPanel" Orientation="Horizontal" SeparationOverride="4">
                <LineEdit Name="EntryFreqLineEdit"
                          HorizontalExpand="True"
                          PlaceHolder="{loc:CMULoc 'cmu-anprc-ui-frequency-placeholder', 'e.g. 1606 or 1.606'}" />
                <Button Name="EntryFreqConfirmButton" Text="{loc:CMULoc 'cmu-anprc-ui-set', 'SET'}"    MinWidth="48" />
              </BoxContainer>

              <!-- NET tab content: scrollable channel list -->
              <ScrollContainer Name="EntryNetScroll" MinHeight="120" MaxHeight="160">
                <BoxContainer Name="EntryNetList" Orientation="Vertical" SeparationOverride="2" />
              </ScrollContainer>

              <Button Name="SlotEntryCloseButton" Text="{loc:CMULoc 'cmu-anprc-ui-close', 'CLOSE'}" />
            </BoxContainer>
          </PanelContainer>

          <!-- Controls -->
          <PanelContainer>
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#17181D" BorderColor="#3D4059" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="ModeButton"    HorizontalExpand="True" Text="{loc:CMULoc 'cmu-anprc-ui-mode-button-fh', 'MODE FH'}"  />
                <Button Name="MonitorButton" HorizontalExpand="True" Text="{loc:CMULoc 'cmu-anprc-ui-monitor-off', 'MON OFF'}"  />
                <Button Name="ScanButton"    HorizontalExpand="True" Text="{loc:CMULoc 'cmu-anprc-ui-scan-off', 'SCAN OFF'}" />
                <Button Name="SquelchButton" HorizontalExpand="True" Text="SQL 3"    />
                <Button Name="TxPowerButton" HorizontalExpand="True" Text="TX MED"   />
              </BoxContainer>
              <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Text="{loc:CMULoc 'cmu-anprc-ui-role', 'ROLE'}"  FontColorOverride="#687A9A" />
                <Label Name="RoleValueLabel"  Text="{loc:CMULoc 'cmu-anprc-ui-rto-relay', 'RTO RELAY'}" FontColorOverride="#C8D2E8" HorizontalExpand="True" />
                <Label Text="{loc:CMULoc 'cmu-anprc-ui-relay', 'RELAY'}" FontColorOverride="#687A9A" />
                <Label Name="RelayValueLabel" Text="{loc:CMULoc 'cmu-anprc-ui-standby', 'STBY'}"      FontColorOverride="#C8D2E8" />
              </BoxContainer>
              <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Name="DiagnosticLineA" Text="{loc:CMULoc 'cmu-anprc-ui-anchor-offline', 'ANCHOR: OFFLINE'}" FontColorOverride="#687A9A" HorizontalExpand="True" />
                <Label Name="DiagnosticLineB" Text="{loc:CMULoc 'cmu-anprc-ui-bypass-no', 'BYPASS: NO'}"      FontColorOverride="#687A9A" />
              </BoxContainer>
              <BoxContainer Orientation="Horizontal" SeparationOverride="4" Margin="0,3,0,0">
                <Button Name="RadioCheckButton" Text="{loc:CMULoc 'cmu-anprc-ui-radio-check', 'RADIO CHECK'}" HorizontalExpand="True" />
              </BoxContainer>
            </BoxContainer>
          </PanelContainer>

          <!-- Search receiver -->
          <BoxContainer Orientation="Horizontal" Margin="2,1,2,0">
            <Label Text="{loc:CMULoc 'cmu-anprc-ui-search', 'SEARCH'}" FontColorOverride="#A9C3E8" HorizontalExpand="True" />
            <Label Name="SweepStatusLabel" Text="{loc:CMULoc 'cmu-anprc-ui-idle', 'IDLE'}" FontColorOverride="#687A9A" />
          </BoxContainer>
          <PanelContainer>
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#17181D" BorderColor="#3D4059" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <Label Name="SweepBandLabel" Text="{loc:CMULoc 'cmu-anprc-ui-band-idle', 'BAND IDLE'}" FontColorOverride="#4A7A55" />
              <Label Name="SweepHintLabel"
                     Text="{loc:CMULoc 'cmu-anprc-ui-search-warning', 'Searching drops all nets and blocks transmit.'}"
                     FontColorOverride="#687A9A" />
              <Button Name="SweepButton" Text="{loc:CMULoc 'cmu-anprc-ui-start-search', 'START SEARCH'}" />
              <Label Text="{loc:CMULoc 'cmu-anprc-ui-contacts', 'CONTACTS'}" FontColorOverride="#A9C3E8" Margin="0,3,0,0" />
              <BoxContainer Name="SweepContactList" Orientation="Vertical" SeparationOverride="2" />
            </BoxContainer>
          </PanelContainer>

          <!-- COMSEC -->
          <BoxContainer Orientation="Horizontal" Margin="2,1,2,0">
            <Label Text="COMSEC" FontColorOverride="#A9C3E8" HorizontalExpand="True" />
            <Label Name="CryptoStatusLabel" Text="{loc:CMULoc 'cmu-anprc-ui-unsecured', 'UNSECURED'}" FontColorOverride="#D65A5A" />
          </BoxContainer>
          <PanelContainer>
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#17181D" BorderColor="#3D4059" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <Label Name="CryptoFillLabel" Text="{loc:CMULoc 'cmu-anprc-ui-fill-none', 'FILL: NONE - insert fill card to load'}" FontColorOverride="#687A9A" />
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="ZeroizeButton"  Text="{loc:CMULoc 'cmu-anprc-ui-zeroize', 'ZEROIZE'}" HorizontalExpand="True" StyleClasses="Caution" />
                <Button Name="DestroyButton"  Text="{loc:CMULoc 'cmu-anprc-ui-destroy', 'DESTROY'}" HorizontalExpand="True" StyleClasses="Caution" />
              </BoxContainer>
              <Button Name="RecryptoButton" Text="{Loc anprc-recrypto-button}" StyleClasses="Caution" />
            </BoxContainer>
          </PanelContainer>

        </BoxContainer>
      </ScrollContainer>

      <!-- Net log: outside the settings scroll so it grows with the window -->
      <BoxContainer Orientation="Horizontal" Margin="2,1,2,0">
        <Label Text="{loc:CMULoc 'cmu-anprc-ui-net-log', 'NET LOG'}" FontColorOverride="#A9C3E8" HorizontalExpand="True" />
        <Label Name="NetLogCountLabel" Text="{loc:CMULoc 'cmu-anprc-ui-zero-entries', '0 entries'}" FontColorOverride="#687A9A" />
      </BoxContainer>
      <BoxContainer Orientation="Horizontal" SeparationOverride="4">
        <OptionButton Name="NetLogChannelFilter" MinWidth="120" />
        <LineEdit Name="NetLogSearchEdit"
                  HorizontalExpand="True"
                  PlaceHolder="{loc:CMULoc 'cmu-anprc-ui-log-filter-placeholder', 'Filter sender / text'}" />
        <Button Name="NetLogFilterClearButton" Text="{loc:CMULoc 'cmu-anprc-ui-clear-short', 'CLR'}" MinWidth="44" />
      </BoxContainer>
      <BoxContainer Orientation="Horizontal" SeparationOverride="4">
        <Button Name="PrintLogButton"        Text="{loc:CMULoc 'cmu-anprc-ui-print-log', 'PRINT LOG'}"        HorizontalExpand="True" />
        <Button Name="PrintInterceptsButton" Text="{loc:CMULoc 'cmu-anprc-ui-print-intercepts', 'PRINT INTERCEPTS'}" HorizontalExpand="True" />
      </BoxContainer>
      <PanelContainer VerticalExpand="True" SizeFlagsStretchRatio="2">
        <PanelContainer.PanelOverride>
          <gfx:StyleBoxFlat BackgroundColor="#07130A" BorderColor="#245236" BorderThickness="1" />
        </PanelContainer.PanelOverride>
        <ScrollContainer VerticalExpand="True" MinHeight="100">
          <BoxContainer Name="NetLogContainer" Orientation="Vertical" SeparationOverride="2" Margin="4,3" />
        </ScrollContainer>
      </PanelContainer>

      <!-- Footer -->
      <PanelContainer>
        <PanelContainer.PanelOverride>
          <gfx:StyleBoxFlat BackgroundColor="#181A20" BorderColor="#343846" BorderThickness="1" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Horizontal" Margin="6,5" SeparationOverride="6">
          <Button Name="PowerButton" Text="{Loc anprc-power-off-button}" MinWidth="96" />
          <Label Name="StatusLabel" Text="" FontColorOverride="#A9C3E8" VerticalAlignment="Center" HorizontalExpand="True" />
        </BoxContainer>
      </PanelContainer>

    </BoxContainer>
  </PanelContainer>

</DefaultWindow>
