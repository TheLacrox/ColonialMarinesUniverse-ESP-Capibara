command-set-entity-xeno-ally-status = Establece el estado de aliado de la colmena de la entidad indicada.
command-set-entity-xeno-ally-status-help = Uso: sethiveally <entidad> <entidad de colmena> <true/false>

command-set-faction-xeno-ally-status = Establece el estado de aliado de la colmena de la facción indicada.
command-set-faction-xeno-ally-status-help = Uso: sethivefactionally <ID de prototipo de facción PNJ> <entidad de colmena> <true/false>

command-clear-xeno-ally-ents = Elimina el estado de aliado de todas las entidades (no facciones) aliadas con una colmena.
command-clear-xeno-ally-ents-help = Uso: clearhiveallies <entidad de colmena>
