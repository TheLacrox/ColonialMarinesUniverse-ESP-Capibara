# CLF Sapper role.
au14-job-name-clfsapper = Zapador de la CLF
au14-job-description-clfsapper = Guerrillero formado en técnicas de campaña y demoliciones. Colocas trampas, las ocultas y usas el propio terreno de la colonia contra GOVFOR.
# Radio prefix must NOT out the sapper: undercover CLF roles all read as ordinary civilians on comms
# (same "CIV" prefix as au14-job-prefix-civiliancolonist / the CLF guerilla).
au14-job-prefix-clfsapper = CIV

# Sapper trap deploy / disarm feedback.
insfor-sapper-trap-deployed = Colocas la carga y queda oculta a la vista.
insfor-sapper-trap-disarmed = Cortas el cable trampa y guardas la carga.
insfor-sapper-trap-deploy-container = No puedes colocar eso aquí dentro.
insfor-sapper-trap-deploy-occupied = Ya hay una trampa en esta casilla.
insfor-sapper-trap-unskilled = Trasteas con ello, pero no tienes ni idea de cómo prepararlo.

# Two-part tripwire.
insfor-sapper-tripwire-attached = Atas el explosivo a la carga del cable trampa.
insfor-sapper-tripwire-full = No hay espacio para fijar otro explosivo.
insfor-sapper-tripwire-need-explosive = Debes fijar un explosivo al cable trampa antes de colocarlo.
insfor-sapper-tripwire-place-other-end = Colocas la carga. Ahora lleva el cable hasta donde quieras que termine, a no más de { $range } casillas, en línea recta y a la vista, y úsalo allí.
insfor-sapper-tripwire-strung = El cable trampa queda tenso y preparado.
insfor-sapper-tripwire-charge-gone = La carga a la que estaba conectado este cable ha desaparecido.
insfor-sapper-tripwire-bad-spot = No puedes tender el cable hasta aquí.
insfor-sapper-tripwire-too-close = Estás justo encima de la carga.
insfor-sapper-tripwire-not-straight = El cable debe extenderse en línea recta desde la carga.
insfor-sapper-tripwire-too-far = Eso está demasiado lejos de la carga.
insfor-sapper-tripwire-no-los = No hay una línea despejada hasta la carga.
insfor-sapper-tripwire-eject-verb = Retirar explosivo
insfor-sapper-tripwire-ejected = Retiras el explosivo de la carga.

# Audio (early-warning) trap.
insfor-sapper-audio-name-title = Trampa sonora
insfor-sapper-audio-name-prompt = Ponle un nombre a esta trampa
insfor-sapper-audio-default-name = Sin nombre
insfor-sapper-audio-location-unknown = ubicación desconocida
insfor-sapper-audio-radio-alert = Se ha activado la trampa sonora {$name}. Ubicación: {$location}.

# Sapper's Workbench.
insfor-sapper-workbench-deployed = Despliegas el banco de trabajo y bloqueas sus patas.
insfor-sapper-workbench-need-materials = Al banco le faltan materiales o ingredientes sueltos (coloca los ingredientes encima o junto a él).
insfor-sapper-workbench-crafted = Fabricas {$item}.

# The "Switch" auto-sear chip.
au14-switch-on = Accionas el interruptor. Al grupo del gatillo dejan de importarle las restricciones.
au14-switch-off = Vuelves a apagar el interruptor.
au14-switch-jammed = El mecanismo se atasca. ¡El arma se ha encasquillado!
au14-switch-exploded = ¡El arma se desarma violentamente entre tus manos!
au14-switch-jammed-shoot = ¡El arma está encasquillada! Acciona primero el mecanismo para despejarla.
au14-switch-rack-verb = Accionar el arma (despejar atasco)
au14-switch-rack-fail = Accionas el mecanismo, pero la vaina sigue encajada.
au14-switch-rack-success = La vaina deformada sale despedida. El arma volverá a disparar.

# Workbench gunsmithing (force attach/detach).
insfor-sapper-workbench-weapon-placed = Colocas el arma sobre el banco.
insfor-sapper-workbench-weapon-occupied = Ya hay un arma sobre el banco.
insfor-sapper-workbench-no-weapon = Coloca primero un arma sobre el banco.
insfor-sapper-workbench-slots-full = Todas las ranuras de esta arma ya están ocupadas.
insfor-sapper-workbench-attached = Fuerzas el accesorio hasta colocarlo ({$slot}).
insfor-sapper-workbench-wrong-slot = Ese accesorio no encaja en ninguna ranura de esta arma.
insfor-sapper-workbench-hold-attachment = Sostén primero un accesorio.
insfor-sapper-workbench-take-weapon = Tomar arma
insfor-sapper-workbench-detach = Desmontar: {$name}

# ATM hacking.
insfor-sapper-atm-already-hacked = Esta máquina ya ha sido saqueada por completo.
insfor-sapper-atm-hacked = El cajero tiembla y expulsa {$amount} en efectivo.
insfor-sapper-atm-malfunction = ERROR: ESTE DISPOSITIVO HA SUFRIDO UN FALLO. CONTACTE CON SU ADMINISTRADOR.
insfor-sapper-console-drained = Los fondos de la consola se vacían y salen {$amount} en efectivo.
insfor-sapper-asrs-drained = La cuenta ASRS se vacía en tus manos: {$amount} en efectivo.
insfor-sapper-asrs-empty = Este terminal no tiene fondos que extraer.

# Spy-camera network.
device-frequency-prototype-name-surveillance-camera-clf = Cámaras espía de la CLF

# Snare trap.
insfor-sapper-snare-caught = ¡Un lazo se cierra alrededor de ti, te inmoviliza las manos y pone el mundo patas arriba!
insfor-sapper-snare-struggled-free = Te liberas a la fuerza del lazo.
insfor-sapper-snare-cutting = Empiezas a cortar el lazo para liberarlo.
insfor-sapper-snare-cut-free = Cortan el lazo y caes libre.

