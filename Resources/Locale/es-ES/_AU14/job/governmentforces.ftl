au14-department-govforces-description = Fuerzas Gubernamentales
au14-department-govforces = Fuerzas Gubernamentales

au14-job-supervisors-govforplatco = Alto Mando
au14-job-supervisors-govfor = Comandante de pelotón

au14-job-name-govforplatco = Comandante
au14-job-description-govforplatco = Dirige la unidad. Gestiona la estrategia y la coordinación de la unidad, y sirve de enlace con el mando desde el CIC.
au14-job-prefix-govforplatco = CMNDR

au14-job-name-govforadjutant = Oficial ejecutivo
au14-job-description-govforadjutant = Mantente preparado para asumir el mando. Ocúpate de la administración de la unidad y asegúrate de que la cadena de mando funcione sin problemas.
au14-job-prefix-govforadjutant = XO

au14-job-name-govforplatop = Oficial de Estado Mayor
au14-job-description-govforplatop = Planifica operaciones y sigue el campo de batalla. Convierte las intenciones del comandante en órdenes y ayuda con la coordinación y la supervisión operativa.
au14-job-prefix-govforplatop = SO

au14-job-name-govforengineering = Oficial de ingeniería
au14-job-description-govforengineering = Mantén operativas bajo presión las estructuras, los recursos y el equipo de la unidad. Reforma la nave como consideres conveniente.
au14-job-prefix-govforengineering = EO

au14-job-name-govforintel = Oficial de inteligencia
au14-job-description-govforintel = Ayuda al comandante con la inteligencia.
au14-job-prefix-govforintel = IO

au14-job-name-govforlogistics = Oficial de logística
au14-job-description-govforlogistics = Mantén abastecido el frente. Ayuda a tus técnicos a gestionar las requisiciones y la distribución sin perder el control del presupuesto.
au14-job-prefix-govforlogistics = LO

au14-job-name-govformo = Oficial médico jefe
au14-job-description-govformo = Supervisa el personal y los recursos médicos de la unidad. Mantén con vida a los heridos y en condiciones de luchar a los enfermos.
au14-job-prefix-govformo = CMO

au14-job-name-govforpolicechief = Jefe de la Policía Militar
au14-job-description-govforpolicechief = Supervisa las operaciones de la Policía Militar. Impón disciplina y mantén el orden dentro de la unidad.
au14-job-prefix-govforpolicechief = CMP

au14-job-name-govfordspilot = Piloto de nave de desembarco
au14-job-description-govfordspilot = Pilota la nave de desembarco. Despliega tropas, evacua bajas y proporciona apoyo de fuego.
au14-job-prefix-govfordspilot = DP

au14-job-name-govfordcc = Jefe de tripulación de nave de desembarco
au14-job-description-govfordcc = Mantén las naves de desembarco. Coordina la carga y los pasajeros, y ayuda a los pilotos.
au14-job-prefix-govfordcc = DCC

au14-job-name-govforSSG = Sargento superior
au14-job-description-govforSSG = Suboficial superior. Mantén el pelotón en funcionamiento.
au14-job-prefix-govforSSG = SNRSRGT

au14-job-name-govforsquadsergeant = Jefe de escuadra
au14-job-description-govforsquadsergeant = Dirige una escuadra. Obedece las órdenes de tus superiores y consigue que tu gente vuelva a casa.
au14-job-prefix-govforsquadsergeant = SL

au14-job-name-govforsquadrifleman = Fusilero
au14-job-description-govforsquadrifleman = La columna vertebral de la unidad. Obedece órdenes, proporciona seguridad y dispara con precisión.
au14-job-prefix-govforsquadrifleman = RFN

au14-job-name-govforcombatcorrespondent = Corresponsal de guerra
au14-job-description-govforcombatcorrespondent = Acompaña a la unidad para informar de la operación. Obedece órdenes, proporciona seguridad y consigue la noticia.
au14-job-prefix-govforcombatcorrespondent = CC

au14-job-name-govforsquadautomaticrifleman = Fusilero automático
au14-job-name-govforsquadautomaticrifleman-plural = Fusileros automáticos
au14-job-description-govforsquadautomaticrifleman = Proporciona fuego de supresión. Mantén al enemigo agachado y a tu escuadra en movimiento.
au14-job-prefix-govforsquadautomaticrifleman = ARFN

au14-job-name-govforplatooncorpsman = Sanitario de pelotón
au14-job-description-govforplatooncorpsman = Presta primeros auxilios sobre el terreno. Cúralos, mantenlos respirando y devuélvelos al combate.
au14-job-name-govforplatooncorpsman-plural = Sanitarios de pelotón
au14-job-prefix-govforplatooncorpsman = HM

au14-job-name-radiotelephoneoperator = Jefe de equipo de fuego
au14-job-name-radiotelephoneoperator-alt = Operador radiotelefónico
au14-job-description-radiotelephoneoperator = Maneja las comunicaciones de largo alcance y dirige equipos de fuego.
au14-job-prefix-radiotelephoneoperator = FTL

au14-job-name-radiotrafficoperator = Operador de tráfico de radio
au14-job-description-radiotrafficoperator = Supervisa y retransmite el tráfico de radio entre el pelotón y el mando.
au14-job-prefix-radiotrafficoperator = RTFO

au14-job-name-govforauxsupportsynth = Sintético de apoyo
au14-job-description-govforauxsupportsynth = Proporciona apoyo logístico, médico, policial y de mando a tu facción.
au14-job-prefix-govforauxsupportsynth = SYNTH

au14-job-name-govforsquadcombattech = Técnico de combate
au14-job-description-govforsquadcombattech = Proporciona apoyo de ingeniería y construcción a tu facción.
au14-job-prefix-govforsquadcombattech = CT

au14-job-name-govforadvisor = Asesor
au14-job-description-govforadvisor = Asesora al mando, forma a los soldados nuevos y presta ayuda donde haga falta.
au14-job-prefix-govforadvisor = ADV

au14-job-name-govforMilitaryDoctor = Oficial médico
au14-job-description-govforMilitaryDoctor = Proporciona a tu facción atención médica de nivel superior.
au14-job-prefix-govforMilitaryDoctor = DOC

au14-job-name-govformilitarypoliceman = Policía militar
au14-job-description-govformilitarypoliceman = Proporciona apoyo policial a tu facción.
au14-job-prefix-govformilitarypoliceman = MP

au14-job-name-govforAuxTech = Técnico de logística
au14-job-description-govforAuxTech = Gestiona las requisiciones y mantén la nave operativa y ordenada. Proporciona apoyo logístico y de ingeniería a bordo para tu facción.
au14-job-prefix-govforAuxTech = AXT

au14-job-name-vehiclecrewman = Tripulante de vehículo
au14-job-description-vehiclecrewman = Maneja, mantén y protege los vehículos blindados de tu facción.
au14-job-prefix-vehiclecrewman = VC

au14-job-name-vehiclecommander = Comandante de vehículo
au14-job-description-vehiclecommander = Dirige los vehículos blindados de tu facción. Da instrucciones a la tripulación, coordínate con la infantería y mantén el vehículo en combate.
au14-job-prefix-vehiclecommander = VCO

au14-job-name-govforweaponsspecialist = Especialista en armamento
au14-job-description-govforweaponsspecialist = Maneja el apoyo de fuego de tu facción y cubre a tu escuadra.
au14-job-prefix-govforweaponsspecialist = WS

au14-job-name-govfornurse = Enfermero
au14-job-description-govfornurse = Ayuda a los médicos y sanitarios a tratar a los heridos.
au14-job-prefix-govfornurse = RN

au14-job-name-govforengineeringtech = Técnico de ingeniería
au14-job-description-govforengineeringtech = Proporciona apoyo de construcción e ingeniería a tu facción.
au14-job-prefix-govforengineeringtech = ET

