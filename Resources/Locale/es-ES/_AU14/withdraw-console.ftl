# Popup messages
withdraw-console-locked = Consola bloqueada. Pasa dos identificaciones autorizadas para desbloquearla.
withdraw-console-id-unbound = Esta identificación no tiene ningún propietario registrado.
withdraw-console-id-wrong-faction = Acceso denegado. Esta identificación no pertenece a un miembro de una facción autorizada.
withdraw-console-id-already-swiped = Ya se han aceptado las credenciales de esta persona.
withdraw-console-id-accepted = Identificación aceptada ({ $count }/2). Pasa otra identificación autorizada.
withdraw-console-unlocked = Consola desbloqueada. El protocolo de retirada ya está disponible.
withdraw-console-dropdown-blocked = Retirada en curso: los ciclos de descenso de la nave de desembarco están bloqueados. Aún puedes regresar a la nave.
withdraw-console-faction-not-allowed = La retirada no está autorizada para esta facción en la operación actual.

# Mid-withdrawal announcement (fires at half the total withdraw duration)
withdraw-console-announcement = AVISO DE RETIRADA DE { $faction }: se ha iniciado una retirada formal. La retirada se completará en { $minutes } minutos. Todo el personal debe prepararse para la evacuación.

# Hijack lock milestone (~1/3 time remaining)
withdraw-console-announcement-hijack-lock = RETIRADA DE { $faction }: quedan { $minutes } minutos.

# Dropdown lock milestone (~1/6 time remaining)
withdraw-console-announcement-dropdown-lock = RETIRADA DE { $faction }: quedan { $minutes } minutos. Todas las operaciones de descenso a la superficie están ahora bloqueadas.

# UI labels
withdraw-console-ui-status-locked = Consola bloqueada. Pasa dos identificaciones autorizadas.
withdraw-console-ui-status-ready = Consola desbloqueada. Protocolo de retirada disponible.
withdraw-console-ui-status-active = RETIRADA EN CURSO
withdraw-console-ui-round-ended = Operación concluida.
withdraw-console-ui-unlocked = Consola desbloqueada (2/2 identificaciones verificadas)
withdraw-console-ui-swipe-count = { $count }/2 identificaciones verificadas
withdraw-console-ui-timer = Quedan { $minutes } min { $seconds } s
withdraw-console-ui-stalemate-toggle = Activar tablas
withdraw-console-ui-stalemate-cancel = Cancelar tablas

# Round end messages
withdraw-console-round-end-withdrawn = { $faction } se ha retirado formalmente de la operación. El enfrentamiento termina con una derrota menor para { $faction }.
withdraw-console-round-end-stalemate = Ambas facciones han acordado quedar en tablas. El enfrentamiento termina en empate.

# Colony-specific
withdraw-console-colony-evac-enabled = Retirada de la colonia confirmada. Los sistemas de repostaje de los botes salvavidas están activos. Evacuación autorizada a partir de los 10 minutos.


