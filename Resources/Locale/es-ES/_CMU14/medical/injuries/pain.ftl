cmu-medical-shrapnel-extract-verb = Extraer metralla
cmu-medical-shrapnel-extract-start = Empiezas a extraer la metralla incrustada.
cmu-medical-shrapnel-extract-finish = Extracción completada: { $count } fragmento{ $count ->
    [one] {""}
   *[other] s
} de metralla.
cmu-medical-shrapnel-movement-pain = La metralla incrustada se desplaza dolorosamente.
