rmc-distress-signal-title = Señal de socorro
rmc-distress-signal-description = Responde a una señal de socorro enviada por un planeta cercano.

cm-distress-signal-majormarinevictory = [color=green]Los últimos xenónidos han sido purgados. Se puede volver a respirar sin peligro... por ahora.[/color]
rmc-distress-signal-majormarinevictory-timeout = [color=green]Con la reina eliminada, la colmena xenónida se derrumba. Por ahora, la zona está a salvo.[/color]
cm-distress-signal-minormarinevictory = [color=green]La reina ha sido eliminada y, con ella, se tambalea la coordinación de la colmena. Los pocos xenónidos restantes apenas suponen una amenaza, pero la guerra no ha terminado.[/color]
cm-distress-signal-majorxenovictory = [color=purple]Sin presas que cazar, los xenónidos vagan con libertad. Los intrusos han desaparecido: se dispersaron, murieron o huyeron, y nadie desafía ya a la colmena.[/color]
cm-distress-signal-minorxenovictory = [color=purple]Los xenónidos secuestraron el ave de metal y entraron por la fuerza en la colmena de metal para buscar al resto de huéspedes.[/color] [color=green]Sin embargo, los marines contraatacaron y eliminaron la amenaza en órbita. Aunque la nave está a salvo y ha sido evacuada,[/color] [color=purple]la superficie sigue invadida y los xenónidos perduran.[/color]

rmc-distress-signal-minorxenovictory-timeout = [color=purple]Los xenónidos secuestraron el ave de metal y entraron en la colmena de metal, lo que desató una batalla brutal en el cielo.[/color] [color=yellow]En medio del caos, la nave perdió el control y se estrelló contra la superficie antes de que todos pudieran evacuar. No hubo supervivientes.[/color] [color=purple]Aun así, la superficie sigue invadida y los xenónidos perduran.[/color]

rmc-distress-signal-alldied-timeout = [color=yellow]La nave secuestrada se estrelló y, tras el desastre, ninguno de los bandos pudo atribuirse la victoria. Los restos flotan en silencio; no hubo supervivientes.[/color]

cm-distress-signal-alldied = [color=yellow]Ni los marines ni los xenónidos sobrevivieron a la carnicería. El campo de batalla yace en silencio, convertido en cementerio de ambos bandos.[/color]
cm-distress-signal-none = [color=yellow]Error de registro de ARES 3.2: faltan los registros de la operación o están dañados. Contacta con soporte e indica el código de error 404 para obtener ayuda.[/color]

