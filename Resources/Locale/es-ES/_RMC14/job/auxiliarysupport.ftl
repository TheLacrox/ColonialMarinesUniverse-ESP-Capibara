# apoyo auxiliar
cm-job-name-aso = Oficial de apoyo auxiliar
cm-job-description-aso = Coordina el departamento de inteligencia y ayuda al oficial ejecutivo.
cm-job-prefix-aso = ASO
CMJobAuxiliarySupportOfficer = Oficial de apoyo auxiliar

cm-job-name-dropship-pilot = Piloto de nave de descenso
cm-job-description-dropship-pilot = Transporta tropas en la nave de descenso y realiza evacuaciones médicas. Asegúrate de que ningún invasor suba a la nave de descenso que tienes asignada.
cm-job-prefix-dropship-pilot = DP
CMJobPilotDropship = Piloto de nave de descenso

cm-job-name-gunship-pilot = Oficial de pilotaje
cm-job-description-gunship-pilot = Mantén la nave de descenso y úsala para proporcionar apoyo aéreo cercano y transporte a la sección de marines.
cm-job-prefix-gunship-pilot = GP
CMJobPilotGunship = Oficial de cañonera

cm-job-name-dcc = Jefe de tripulación de nave de descenso
cm-job-description-dcc = Ayuda al piloto, mantén la nave de descenso de la nave principal y atiende a quienes resulten heridos a bordo.
cm-job-prefix-dcc = DCC
CMJobDropshipCrewChief = Jefe de tripulación de nave de descenso

cm-job-name-intel = Oficial de inteligencia
cm-job-description-intel = Recupera material de inteligencia en tierra, procésalo y consigue puntos tecnológicos para apoyar la operación con ojivas de bombardeo orbital, puntos para la nave de descenso o suministros de requisiciones.
cm-job-prefix-intel = IO
CMJobIntelOfficer = Oficial de inteligencia
