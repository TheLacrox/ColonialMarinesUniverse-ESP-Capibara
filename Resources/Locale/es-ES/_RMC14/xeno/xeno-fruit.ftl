# Elección de fruta
rmc-xeno-fruit-choose = Ahora plantaremos {$fruit} al secretar resina.

# Fallos al plantar
rmc-xeno-fruit-plant-failed = ¡No podemos plantar ahí!
rmc-xeno-fruit-plant-failed-weeds = ¡No podemos plantar una fruta sin un jardín de maleza!
rmc-xeno-fruit-plant-failed-select = ¡Primero debes seleccionar una fruta que plantar! Usa la acción «Elegir fruta de resina».
rmc-xeno-fruit-plant-failed-hive = Esta maleza no pertenece a nuestra colmena; rechaza nuestra fruta.
rmc-xeno-fruit-plant-failed-resin-hole = ¡Este lugar está demasiado cerca de un agujero de resina!
rmc-xeno-fruit-plant-failed-fruit = ¡Este lugar está demasiado cerca de otra fruta!
rmc-xeno-fruit-plant-failed-node = ¡Ya hay un nodo de resina aquí!

# Éxito al plantar
rmc-xeno-fruit-plant-limit-exceeded = ¡No podemos sustentar otra fruta; una se marchitará para que esta pueda vivir!
rmc-xeno-fruit-plant-success-self = ¡Secretamos parte de nuestros fluidos vitales y les damos forma de fruta!
rmc-xeno-fruit-plant-success-others = ¡{CAPITALIZE(THE($xeno))} secreta fluidos y les da forma de fruta!

# Cosecha
rmc-xeno-fruit-crush = Aplastamos {THE($fruit)}.
rmc-xeno-fruit-harvest-start-xeno = Empezamos a arrancar {THE($fruit)}...
rmc-xeno-fruit-harvest-start-marine = Empiezas a arrancar {THE($fruit)}...
rmc-xeno-fruit-harvest-failed-xeno = ¡No podemos cosechar eso!
rmc-xeno-fruit-harvest-failed-marine = ¡No puedes cosechar eso!
rmc-xeno-fruit-harvest-failed-too-small = ¡Somos demasiado pequeñas para recoger {THE($fruit)}!
rmc-xeno-fruit-harvest-failed-not-mature-xeno = {CAPITALIZE(THE($fruit))} se desintegra entre nuestras manos cuando la arrancamos.
rmc-xeno-fruit-harvest-failed-not-mature-marine = {CAPITALIZE(THE($fruit))} se desintegra entre tus manos cuando la arrancas.
rmc-xeno-fruit-harvest-success-xeno = Arrancamos {THE($fruit)}.
rmc-xeno-fruit-harvest-success-marine = Arrancas {THE($fruit)}.

# Consumo de fruta (desde el suelo)
rmc-xeno-fruit-pick-prepare = Nos preparamos para consumir {THE($fruit)}.
rmc-xeno-fruit-pick-failed-already = ¡{CAPITALIZE(THE($fruit))} ya está siendo recogida!
rmc-xeno-fruit-pick-failed-no-longer = Ya no podemos consumir {THE($fruit)}.
rmc-xeno-fruit-pick-failed-not-mature = {CAPITALIZE(THE($fruit))} aún no está madura. Debemos esperar un poco más.
rmc-xeno-fruit-pick-failed-health-full = ¡Tenemos toda la salud! Esto sería un desperdicio...
rmc-xeno-fruit-pick-failed-health-full-target = ¡Tiene toda la salud! Esto sería un desperdicio...

# Ingesta de fruta
rmc-xeno-fruit-eat-start-self = Empezamos a comer {THE($fruit)}.
rmc-xeno-fruit-eat-start-others = {CAPITALIZE(THE($xeno))} empieza a comer {THE($fruit)}.

rmc-xeno-fruit-eat-fail-self = No logramos comer {THE($fruit)}.
rmc-xeno-fruit-eat-fail-others = {CAPITALIZE(THE($xeno))} no logra comer {THE($fruit)}.

rmc-xeno-fruit-eat-success-self = Nos comimos {THE($fruit)}.
rmc-xeno-fruit-eat-success-others = {CAPITALIZE(THE($xeno))} se comió {THE($fruit)}.

# Alimentación con fruta
rmc-xeno-fruit-feed-refuse = {CAPITALIZE(THE($target))} se niega a comer {THE($fruit)}.
rmc-xeno-fruit-feed-dead = {CAPITALIZE(THE($target))} ya está muerta; ahora la fruta no le servirá...

rmc-xeno-fruit-feed-start-self = Empezamos a alimentar a {THE($target)} con {THE($fruit)}.
rmc-xeno-fruit-feed-start-target = {CAPITALIZE(THE($user))} empieza a alimentarnos con {THE($fruit)}.
rmc-xeno-fruit-feed-start-others = {CAPITALIZE(THE($user))} empieza a alimentar a {THE($target)} con {THE($fruit)}.

rmc-xeno-fruit-feed-fail-self = No logramos alimentar a {THE($target)} con {THE($fruit)}.
rmc-xeno-fruit-feed-fail-target = {CAPITALIZE(THE($user))} no logra alimentarnos con {THE($fruit)}.
rmc-xeno-fruit-feed-fail-others = {CAPITALIZE(THE($user))} no logra alimentar a {THE($target)} con {THE($fruit)}.

rmc-xeno-fruit-feed-success-self = Alimentamos a {THE($target)} con {THE($fruit)}.
rmc-xeno-fruit-feed-success-target = {CAPITALIZE(THE($user))} nos alimentó con {THE($fruit)}.
rmc-xeno-fruit-feed-success-others = {CAPITALIZE(THE($user))} alimentó a {THE($target)} con {THE($fruit)}.

# Fruta retirada
rmc-xeno-fruit-destroyed = ¡Percibimos que han destruido una de nuestras frutas!
rmc-xeno-fruit-consumed = Han consumido una de nuestras frutas de resina.
rmc-xeno-fruit-picked = Han recogido una de nuestras frutas de resina.

# Avisos emergentes de efectos de fruta
rmc-xeno-fruit-effect-lesser = Nos recuperamos un poco de nuestras heridas.
rmc-xeno-fruit-effect-greater = Nos recuperamos un poco de nuestras heridas y empezamos a regenerarnos con rapidez.
rmc-xeno-fruit-effect-unstable = Notamos que nuestras defensas se refuerzan y empezamos a regenerarnos con rapidez.
rmc-xeno-fruit-effect-spore = ¡Notamos que nos invade un frenesí! ¡Nuestras habilidades se enfriarán más deprisa a medida que ataquemos con las garras!
rmc-xeno-fruit-effect-speed = ¡La fruta nos vigoriza y nos permite movernos más deprisa!
rmc-xeno-fruit-effect-plasma = ¡La fruta potencia nuestra regeneración de plasma!
rmc-xeno-fruit-effect-already = Ya estamos bajo los efectos de {THE($fruit)}; ¡sal y mata!
rmc-xeno-fruit-effect-already-feed = ¡{CAPITALIZE(THE($xeno))} ya está bajo los efectos de {THE($fruit)}!
rmc-xeno-fruit-effect-end = Notamos que los efectos de la fruta se desvanecen...

# Verbos
rmc-xeno-fruit-verb-harvest = Cosechar
rmc-xeno-fruit-verb-consume = Consumir
rmc-xeno-fruit-verb-feed = Alimentar

# Texto de examen
rmc-xeno-fruit-examine-base = Esta fruta está {$growthStatus}.
rmc-xeno-fruit-examine-growing = todavía [color=darkred]creciendo[/color]
rmc-xeno-fruit-examine-grown = [color=darkgreen]completamente desarrollada[/color]
rmc-xeno-fruit-examine-spent = [color=orange]agotada[/color]

# Texto de la interfaz
rmc-xeno-fruit-ui-title = Elegir fruta de resina
rmc-xeno-fruit-ui-count = Frutas plantadas: {$count}/{$max}

# Colmena distinta
rmc-xeno-fruit-wrong-hive = ¡Esto no procede de nuestra colmena!
rmc-xeno-fruit-feed-wrong-hive = ¡{THE($target)} no pertenece a nuestra colmena!

# Maleza
rmc-xeno-fruit-weed-boost = Percibimos que esta maleza multiplica el tiempo de crecimiento de las frutas de resina por un [bold]{$percent}%[/bold].

# Efectos
rmc-xeno-fruit-consume-examine = Esta fruta produce los siguientes efectos al consumirla:
rmc-xeno-fruit-instant-heal = Restaura al instante [bold]{$amount}[/bold] de salud.
rmc-xeno-fruit-regen-heal = Regenera [bold]{$amount}[/bold] de salud por segundo durante {$time} segundos.
rmc-xeno-fruit-shield = Concede un sobreescudo equivalente al [bold]{$percent}%[/bold] de nuestra salud máxima, hasta un máximo de [bold]{$max}[/bold]. Empieza a deteriorarse después de {$duration} segundos y pierde {$decay} por segundo.
rmc-xeno-fruit-cooldown = En el próximo uso, reduce los tiempos de recarga de las habilidades un [bold]{$amount}%[/bold] al atacar con las garras, hasta un máximo del [bold]{$max}%[/bold]. Este efecto dura {$time} segundos.
rmc-xeno-fruit-speed = Aumenta nuestra velocidad en [bold]{$amount}[/bold] durante {$time} segundos.
rmc-xeno-fruit-regen-plasma = Regenera [bold]{$amount}[/bold] de plasma por segundo durante {$time} segundos.
