# addaction
cmd-addaction-desc = Añade una acción a la entidad objetivo. La acción no funcionará si el objetivo requiere algún componente adicional en su entidad (como Devorar del Dragón).
cmd-addaction-help = addaction <UID de entidad> <prototipo de acción>

cmd-addaction-invalid-args = Se esperaban exactamente 2 argumentos.
cmd-addaction-actions-not-found = La entidad objetivo no puede usar acciones.
cmd-addaction-action-not-found = No se encontró ningún prototipo de acción que coincida con {$action}.
cmd-addaction-adding-failed = No se pudo añadir la acción.

cmd-addaction-player-completion = <UID de entidad>
cmd-addaction-action-completion = <prototipo de acción>
