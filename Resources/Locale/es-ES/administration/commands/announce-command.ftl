cmd-announce-desc = Envía un anuncio dentro del juego con un color y un sonido personalizados.
cmd-announce-help = {$command} <mensaje> [remitente] [color] [sonido] - Envía un anuncio. El remitente predeterminado es CentCom, el color es Gold y el sonido es announce.ogg. El color debe tener el formato #RRGGBB.

# Remitente predeterminado del anuncio
cmd-announce-sender = Mando Central

# Sugerencias de compleción
cmd-announce-arg-message = <mensaje>
cmd-announce-arg-sender = [remitente]
cmd-announce-arg-color = [color]
cmd-announce-arg-sound = [sonido]
