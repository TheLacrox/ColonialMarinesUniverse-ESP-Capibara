cmd-panicbunker-desc = Alterna el búnker de pánico, que impone restricciones más estrictas sobre quién puede conectarse al servidor.
cmd-panicbunker-help = Uso: panicbunker
panicbunker-command-enabled = Se ha activado el búnker de pánico.
panicbunker-command-disabled = Se ha desactivado el búnker de pánico.

cmd-panicbunker_disable_with_admins-desc = Alterna si el búnker de pánico se desactiva cuando se conecta un administrador.
cmd-panicbunker_disable_with_admins-help = Uso: panicbunker_disable_with_admins
panicbunker-command-disable-with-admins-enabled = El búnker de pánico se desactivará automáticamente cuando haya administradores conectados.
panicbunker-command-disable-with-admins-disabled = El búnker de pánico no se desactivará automáticamente cuando haya administradores conectados.

cmd-panicbunker_enable_without_admins-desc = Alterna si el búnker de pánico se activa cuando se desconecta el último administrador.
cmd-panicbunker_enable_without_admins-help = Uso: panicbunker_enable_without_admins
panicbunker-command-enable-without-admins-enabled = El búnker de pánico se activará automáticamente cuando no haya administradores conectados.
panicbunker-command-enable-without-admins-disabled = El búnker de pánico no se activará automáticamente cuando no haya administradores conectados.

cmd-panicbunker_count_deadminned_admins-desc = Alterna si se cuentan los administradores que se hayan retirado los permisos al activar y desactivar automáticamente el búnker de pánico.
cmd-panicbunker_count_deadminned_admins-help = Uso: panicbunker_count_deadminned_admins
panicbunker-command-count-deadminned-admins-enabled = El búnker de pánico contará a los administradores sin permisos cuando se active y desactive automáticamente.
panicbunker-command-count-deadminned-admins-disabled = El búnker de pánico no contará a los administradores sin permisos cuando se active y desactive automáticamente.

cmd-panicbunker_show_reason-desc = Alterna si se muestra a los clientes que intentan conectarse el motivo por el que el búnker de pánico bloqueó su conexión.
cmd-panicbunker_show_reason-help = Uso: panicbunker_show_reason
panicbunker-command-show-reason-enabled = El búnker de pánico mostrará el motivo a los usuarios cuya conexión bloquee.
panicbunker-command-show-reason-disabled = El búnker de pánico dejará de mostrar el motivo a los usuarios cuya conexión bloquee.

cmd-panicbunker_min_account_age-desc = Obtiene o establece la antigüedad mínima de la cuenta, en minutos, necesaria para conectarse con el búnker de pánico activado.
cmd-panicbunker_min_account_age-help = Uso: panicbunker_min_account_age <minutos>
panicbunker-command-min-account-age-is = La antigüedad mínima de la cuenta para el búnker de pánico es de {$minutes} minutos.
panicbunker-command-min-account-age-set = La antigüedad mínima de la cuenta para el búnker de pánico se estableció en {$minutes} minutos.

cmd-panicbunker_min_overall_minutes-desc = Obtiene o establece el tiempo de juego total mínimo, en minutos, necesario para conectarse con el búnker de pánico activado.
cmd-panicbunker_min_overall_minutes-help = Uso: panicbunker_min_overall_minutes <minutos>
panicbunker-command-min-overall-minutes-is = El tiempo de juego total mínimo para el búnker de pánico es de {$minutes} minutos.
panicbunker-command-min-overall-minutes-set = El tiempo de juego total mínimo para el búnker de pánico se estableció en {$minutes} minutos.
