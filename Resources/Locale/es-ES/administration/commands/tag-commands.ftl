addtag-command-description = Añade una etiqueta a una entidad determinada
addtag-command-help = Uso: addtag <uid de entidad> <etiqueta>

addtag-command-success = Se añadió {$tag} a {$target}.
addtag-command-fail = No se pudo añadir {$tag} a {$target}.

removetag-command-description = Elimina una etiqueta de una entidad determinada
removetag-command-help = Uso: removetag <uid de entidad> <etiqueta>

removetag-command-success = Se eliminó {$tag} de {$target}.
removetag-command-fail = No se pudo eliminar {$tag} de {$target}.

tag-command-arg-tag = Etiqueta
