suicide-command-description = Se suicida
suicide-command-help-text = El comando suicide te permite abandonar rápidamente una ronda sin salirte del personaje.
                            El método varía: primero intentará usar el objeto que sostengas en la mano activa.
                            Si eso falla, intentará usar un objeto del entorno.
                            Por último, si nada de lo anterior funciona, morirás al morderte la lengua.
suicide-command-default-text-others = ¡{CAPITALIZE(THE($name))} intenta morder {POSS-ADJ($name)} propia lengua!
suicide-command-default-text-self = ¡Intentas morderte la lengua!
suicide-command-already-dead = No puedes suicidarte. Ya estás muerto.
suicide-command-no-mind = ¡No tienes mente!
suicide-command-denied = Ahora mismo no puedes suicidarte.
