
### Interfaz

# Verbo para trepar
comp-climbable-verb-climb = Saltar por encima

### Mensajes de interacción

# Se muestra cuando saltas sobre $climbable.
comp-climbable-user-climbs = ¡Saltas sobre { THE($climbable) }!

# Se muestra a los demás cuando $user salta sobre $climbable.
comp-climbable-user-climbs-other  = ¡{ CAPITALIZE(THE($user)) } salta sobre { THE($climbable) }!

# Se muestra al obligar a alguien a subir sobre $climbable.
comp-climbable-user-climbs-force = ¡Obligas a { THE($moved-user) } a subir sobre { THE($climbable) }!

# Se muestra a los demás cuando alguien obliga a $moved-user a subir.
comp-climbable-user-climbs-force-other = ¡{ CAPITALIZE(THE($user)) } obliga a { THE($moved-user) } a subir sobre { THE($climbable) }!

# Se muestra cuando estás demasiado lejos.
comp-climbable-cant-reach = ¡No llegas hasta ahí!

# Se muestra cuando no puedes interactuar por algún motivo.
comp-climbable-cant-interact = ¡No puedes hacer eso!

# Se muestra cuando no puedes trepar por tus propios medios.
comp-climbable-cant-climb = ¡No eres capaz de trepar!

# Se muestra al intentar obligar a subir a alguien que no puede hacerlo.
comp-climbable-target-cant-climb = ¡{ CAPITALIZE(THE($moved-user)) } no puede subir ahí!
