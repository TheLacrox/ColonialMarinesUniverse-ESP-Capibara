cmd-removeextracomponents-desc = Elimina de todas las entidades del ID especificado cualquier componente que no figure en su prototipo.\nSi no se especifica ningún ID, se aplica a todas las entidades.
cmd-removeextracomponents-help = removeextracomponents / removeextracomponents <id de entidad>
cmd-removeextracomponents-invalid-prototype-id = No se puede encontrar un prototipo de entidad con el ID {$id}.
cmd-removeextracomponents-success = Se eliminaron {$count} componentes de {$entities}.
cmd-removeextracomponents-success-with-id = Se eliminaron {$count} componentes de {$entities} con el ID {$id}.
