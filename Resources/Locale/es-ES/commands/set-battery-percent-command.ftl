cmd-setbatterypercent-desc = Descarga o recarga una batería según el uid de entidad y un porcentaje; por ejemplo: forall with Battery do setbatterypercent $ID 0
cmd-setbatterypercent-help = Uso: setbatterypercent <id> <porcentaje>
cmd-setbatterypercent-battery-not-found = No se encontró ninguna batería con el ID {$id}.
cmd-setbatterypercent-not-valid-percent = {$arg} no es un número decimal válido (porcentaje).
