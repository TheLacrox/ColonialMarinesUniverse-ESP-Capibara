cmd-showaccessreaders-desc = Alterna la visualización de los permisos de los lectores de acceso en el mapa
cmd-showaccessreaders-help =
    Información de la superposición:
    -Desactivado | El lector de acceso está desactivado
    +Sin restricciones | El lector de acceso no tiene restricciones
    +Conjunto [Índice]: [Nombre de etiqueta] | Una etiqueta de un conjunto de accesos (el acceso necesita que el conjunto permita todas sus etiquetas)
    +Clave [Uid de estación]: [Id de StationRecordKey] | Una StationRecordKey permitida
    -Etiqueta [Nombre de etiqueta] | Una etiqueta no permitida (tiene prioridad sobre otros permisos)
cmd-showaccessreaders-status = La superposición de depuración de lectores de acceso se estableció en {$status}.
