signal-port-name-pressed = Pulsado
signal-port-description-pressed = Este puerto se activa cada vez que se acciona el transmisor.

signal-port-name-on-transmitter = Encendido
signal-port-description-on-transmitter = Este puerto se activa cada vez que se enciende el transmisor.

signal-port-name-off-transmitter = Apagado
signal-port-description-off-transmitter = Este puerto se activa cada vez que se apaga el transmisor.

signal-port-name-status-transmitter = Estado
signal-port-description-status-transmitter = Este puerto se activa con HIGH o LOW según el estado del transmisor.

signal-port-name-left = Izquierda
signal-port-description-left = Este puerto se activa cada vez que la palanca se desplaza a la posición del extremo izquierdo.

signal-port-name-right = Derecha
signal-port-description-right = Este puerto se activa cada vez que la palanca se desplaza a la posición del extremo derecho.

signal-port-name-doorstatus = Estado de la puerta
signal-port-description-doorstatus = Este puerto se activa con HIGH cuando la puerta se abre y con LOW cuando termina de cerrarse.

signal-port-name-dockstatus = Estado de acoplamiento
signal-port-description-dockstatus = Este puerto se activa con HIGH al acoplarse y con LOW al desacoplarse.

signal-port-name-middle = Centro
signal-port-description-middle = Este puerto se activa cada vez que la palanca se desplaza a la posición neutra.

signal-port-name-timer-trigger = Activación del temporizador
signal-port-description-timer-trigger = Este puerto se activa cada vez que se dispara el temporizador.

signal-port-name-timer-start = Inicio del temporizador
signal-port-description-timer-start = Este puerto se activa cada vez que se inicia el temporizador.

signal-port-name-logic-output = Salida
signal-port-description-logic-output = Este puerto se activa con HIGH o LOW según la puerta y las entradas seleccionadas.

signal-port-name-logic-output-high = Salida alta
signal-port-description-logic-output-high = Este puerto se activa cada vez que la entrada presenta un flanco ascendente.

signal-port-name-logic-output-low = Salida baja
signal-port-description-logic-output-low = Este puerto se activa cada vez que la entrada presenta un flanco descendente.

signal-port-name-air-danger = Peligro
signal-port-description-air-danger = Este puerto se activa con HIGH en modo de peligro y con LOW cuando no lo está.

signal-port-name-air-warning = Advertencia
signal-port-description-air-warning = Este puerto se activa con HIGH en modo de advertencia y con LOW cuando no lo está.

signal-port-name-air-normal = Normal
signal-port-description-air-normal = Este puerto se activa con HIGH en modo normal y con LOW cuando no lo está.

signal-port-name-decaying = En descomposición
signal-port-description-decaying = Este puerto se activa cuando una anomalía vinculada comienza a descomponerse.

signal-port-name-stabilize = Estabilización
signal-port-description-stabilize = Este puerto se activa cuando una anomalía vinculada se normaliza.

signal-port-name-growing = En crecimiento
signal-port-description-growing = Este puerto se activa cuando una anomalía vinculada comienza a crecer.

signal-port-name-pulse = Pulso
signal-port-description-pulse = Este puerto se activa cuando una anomalía vinculada emite pulsos.

signal-port-name-supercrit = Supercrítica
signal-port-description-supercrit = Este puerto se activa cuando una anomalía vinculada explota tras alcanzar el estado supercrítico.

signal-port-name-power-charging = Cargando
signal-port-description-power-charging = Este puerto se activa con HIGH cuando la batería gana carga y con LOW cuando no.

signal-port-name-power-discharging = Descargando
signal-port-description-power-discharging = Este puerto se activa con HIGH cuando la batería pierde carga y con LOW cuando no.

signal-port-name-item-detected = Detectado
signal-port-description-item-detected = Este puerto se activa cada vez que el transmisor detecta un objeto.
