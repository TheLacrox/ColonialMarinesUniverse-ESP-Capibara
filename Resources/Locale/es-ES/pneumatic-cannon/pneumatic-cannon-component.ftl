### Localización del cañón neumático.

pneumatic-cannon-component-itemslot-name = Depósito de gas

## Se muestra al intentar disparar sin gas.

pneumatic-cannon-component-fire-no-gas = { CAPITALIZE(THE($cannon)) } hace clic, pero no expulsa gas.

## Se muestra al cambiar la potencia.

pneumatic-cannon-component-change-power = { $power ->
    [High] Ajustas el limitador a la potencia máxima. Parece excesiva...
    [Medium] Ajustas el limitador a una potencia intermedia.
    *[Low] Ajustas el limitador a baja potencia.
}

## Se muestra al quedar aturdido por usar demasiada potencia.

pneumatic-cannon-component-power-stun = ¡La fuerza bruta de { THE($cannon) } te derriba!

