ent-ActionMarineCallToAttention = ¡Firmes!
    .desc = Ordena al personal visible ponerse firmes y bajar la voz.

ent-AU14BarricadeMetal = barricada metálica
    .desc = Una barricada resistente y fácil de montar, fabricada con placas de metal y utilizada a menudo para levantar fortificaciones rápidas. Usa un soplete para repararla.
    .suffix = AU14, construcción fantasmal

ent-AU14BarricadeMetalDoor = barricada metálica plegable
    .desc = Una barricada metálica plegable más débil que su equivalente fijo. Puede abrirse y cerrarse en un instante. Repárala con un soldador.
    .suffix = AU14, construcción fantasmal

ent-AU14BarricadePlasteel = barricada de plastiacero
    .desc = Una barricada resistente y fácil de montar, fabricada con placas de plastiacero reforzado: la cumbre de las posiciones fortificadas. Usa un soplete para repararla.
    .suffix = AU14, construcción fantasmal

ent-AU14BarricadePlasteelDoor = barricada de plastiacero plegable
    .desc = Una barricada plegable de plastiacero más resistente que su equivalente metálico. Puede abrirse y cerrarse en un instante. Repárala con un soldador.
    .suffix = AU14, construcción fantasmal

ent-AU14BarricadeWood = barricada de madera
    .desc = Una pared hecha con tablones de madera clavados entre sí. No es muy resistente, pero ofrece algo de cobertura.
    .suffix = AU14, construcción fantasmal

ent-AU14BuildBarrelBlue = barril azul
    .desc = Un barril de almacenamiento azul.
    .suffix = AU14, construible

ent-AU14BuildBarrelGreen = barril verde
    .desc = Un barril de almacenamiento verde.
    .suffix = AU14, construible

ent-AU14BuildBarrelRed = barril rojo
    .desc = Un barril de almacenamiento rojo.
    .suffix = AU14, construible

ent-AU14BuildBarrelWhite = barril blanco
    .desc = Un barril de almacenamiento blanco.
    .suffix = AU14, construible

ent-AU14BuildBarrelYellow = barril amarillo
    .desc = Un barril de almacenamiento amarillo.
    .suffix = AU14, construible

ent-AU14BuildCloset = armario de emergencia
    .desc = Una unidad de almacenamiento para mascarillas respiratorias y tanques de oxígeno de emergencia.
    .suffix = AU14, construible

ent-AU14BuildPottedPlant = planta en maceta
    .desc = Un pedacito de naturaleza contenido en una maceta.
    .suffix = AU14, construible

ent-AU14BuildRack = estantería
    .desc = Un conjunto de baldas metálicas apiladas. Excelente para almacenar cosas; bastante menos útil como cobertura.
    .suffix = AU14, construible

ent-AU14BuildTable = mesa
    .desc = Una superficie metálica cuadrada apoyada sobre cuatro patas. Resulta útil para colocar cosas encima.
    .suffix = AU14, construible

ent-AU14BuildTableReinforced = mesa reforzada
    .desc = Una superficie metálica cuadrada apoyada sobre cuatro patas. Esta tiene paneles laterales, por lo que también sirve como escritorio.
    .suffix = AU14, construible

ent-AU14BuildTableReinforcedMid = mesa reforzada
    .desc = Una superficie metálica cuadrada apoyada sobre cuatro patas. Esta tiene paneles laterales, por lo que también sirve como escritorio.
    .suffix = AU14, construible, en desarrollo

ent-AU14BuildTableWood = mesa de madera
    .desc = Una superficie cuadrada de madera apoyada sobre cuatro patas. Resulta útil para colocar cosas encima.
    .suffix = AU14, construible

ent-AU14BuildWallHeavy = casco reforzado pesado
    .desc = Un enorme bloque de metal ultrarreforzado empleado para separar estancias. Parece prácticamente indestructible.
    .suffix = AU14, construible

ent-AU14BuildWallHeavyMid = casco reforzado pesado
    .desc = Un enorme bloque de metal ultrarreforzado empleado para separar estancias. Parece prácticamente indestructible.
    .suffix = AU14, construible, en desarrollo

ent-AU14BuildWallMetal = pared
    .desc = Un enorme bloque de metal empleado para separar estancias.
    .suffix = AU14, construible

ent-AU14BuildWallReinforced = pared reforzada
    .desc = Un enorme bloque de metal reforzado empleado para separar estancias.
    .suffix = AU14, construible

ent-AU14BuildWallReinforcedMid = pared reforzada
    .desc = Un enorme bloque de metal reforzado empleado para separar estancias.
    .suffix = AU14, construible, en desarrollo

ent-AU14BuildWallWood = pared de madera
    .desc = Una pared de madera empleada para separar estancias.
    .suffix = AU14, construible

ent-AU14CustomConstructionFrame = armazón de construcción
    .desc = Una construcción sin terminar. Completa los pasos restantes para finalizarla o desmóntala con una palanca para cancelar.
    .suffix = AU14, construcción personalizada

ent-AU14APackage = un paquete
    .desc = Un paquete sencillo con tu nombre. Úsalo en la mano para desempaquetar tu equipo.

ent-AU14HeavyCellKit = equipo pesado de la célula
    .desc = El equipo desplegable de la célula, embalado de forma compacta. Úsalo en la mano para abrir el menú de despliegue y colocar una pieza cada vez.

ent-AU14SpawnPointCLFSapper = punto de aparición: zapador CLF
    .desc = Un generador de puestos de RMC14. Se utiliza al inicio de la ronda y para incorporaciones tardías.
    .suffix = aparición de puesto

ent-AU14CLFCameraMonitor = monitor de cámaras CLF
    .desc = Un monitor portátil improvisado y conectado a las cámaras espía ocultas de la célula.
    .suffix = CLF, zapador

ent-AU14CLFCameraRelay = repetidor para cámaras espía
    .desc = Un repetidor de bolsillo que enlaza discretamente las cámaras espía de la célula con su monitor. Mantenlo dentro del alcance de ambos.
    .suffix = CLF, zapador

ent-AU14CLFSpyCamera = cámara espía
    .desc = Una diminuta cámara estenopeica que la célula puede guardar, dejar en el suelo o fijar para vigilar un acceso y enviar la imagen a su monitor.
    .suffix = CLF, zapador

ent-AU14SapperAudioTrap = trampa sonora
    .desc = Una alarma de silbato conectada a un cable trampa casi invisible. Cualquier cosa que cruce el cable provoca un chillido y comunica por radio a la célula dónde ocurrió. Córtalo con un cortaalambres para silenciarlo.

ent-AU14SapperCraftingKit = materiales para trampas improvisadas
    .desc = Un fardo de chatarra, cable y explosivos recuperados. Úsalo en la mano para fabricar trampas CLF en el lugar donde te encuentres.
    .suffix = CLF, zapador

ent-AU14SapperIED = IED enterrado
    .desc = Un artefacto explosivo improvisado enterrado bajo la superficie y conectado a una placa de presión oculta. Lleva carga suficiente para arrasar aquello que tenga la mala suerte de pisarlo.

ent-AU14SapperShotgunTrap = trampa de escopeta
    .desc = Un cañón recortado atado a una estaca y conectado a un cable trampa. Si pasas por delante, descarga un cartucho de perdigones contra tus piernas.

ent-AU14SapperSnareTrap = trampa de lazo
    .desc = Una maraña oculta de cable y ganchos. Si la pisas, se cierra con fuerza, te inmoviliza las manos y te derriba.

ent-AU14SapperTrapAreaPreview = zona de activación de la trampa
    .desc = La zona en la que se activará la trampa que estás colocando.

ent-AU14SapperTrapToolbox = equipo de trampas del zapador
    .desc = Una caja de herramientas maltrecha, repleta de cargas improvisadas y cables trampa. Todo lo que un zapador CLF necesita para sembrar una zona de muerte.
    .suffix = CLF, zapador

ent-AU14SapperTripwireEnd = estaca del cable trampa
    .desc = La estaca del extremo en la que se fija un cable trampa.

ent-AU14SapperTripwireEndPlacer = bobina de cable trampa
    .desc = El extremo suelto de un cable trampa, unido por cable a una carga colocada. Úsalo donde quieras que termine el cable.
    .suffix = CLF, zapador

ent-AU14SapperTripwireSegment = cable trampa
    .desc = Un cable casi invisible tensado entre una carga y su estaca. Cruzarlo es una idea pésima.

ent-AU14SapperTripwireTrap = carga con cable trampa
    .desc = Una caja de disparo conectada a un cable trampa casi invisible que se extiende varias baldosas hasta una estaca. Acopla granadas o explosivos a la caja y colócala: si algo que no sea amistoso cruza el cable, todo detonará a la vez. Córtalo con un cortaalambres para desactivarlo.

ent-AU14SapperSiphonRig = equipo de extracción de fondos
    .desc = Un artilugio de extracción montado con cableado recuperado y lectores de tarjetas clonados. Conéctalo a un cajero, una consola presupuestaria o una terminal ASRS de la colonia para desviar discretamente sus fondos y convertirlos en efectivo.
    .suffix = CLF, zapador

ent-AU14SapperWorkbench = banco de trabajo del zapador
    .desc = Este banco de trabajo parece diseñado para empuñaduras de armas, componentes informáticos precisos y piezas especializadas. Aliméntalo con láminas de metal, plastiacero, plástico o madera; coloca piezas saqueadas encima para las recetas más sofisticadas.
    .suffix = CLF, zapador

ent-AU14SapperWorkbenchKit = equipo de banco de trabajo del zapador
    .desc = Un banco de trabajo de campaña plegado. Úsalo en la mano para desplegarlo donde te encuentres. Solo un zapador adiestrado sabe utilizarlo.
    .suffix = CLF, zapador

ent-AU14AttachmentSwitch = selector automático
    .desc = Un diminuto fiador invertido que encaja en el mecanismo del gatillo. Al activarlo, el arma deja de preguntarse cuándo debe dejar de disparar. Es totalmente ilegal, tremendamente impreciso y propenso a encasquillarse.
    .suffix = CLF, zapador

ent-AU14SmeltingPot = crisol de fundición
    .desc = Un crisol bajo de hierro, con el borde cubierto de escoria antigua. Con un buen fuego y paciencia, convierte el mineral en metal, el metal en plastiacero y un puñado de placas de circuito estropeadas en plástico.

ent-XenoCollapseResin = costra de resina
    .desc = Una costra oscura de resina endurecida, tejida densamente sobre un agujero del suelo. Soporta peso, pero por muy poco.

ent-AU14CollapseFog = neblina de cascada
    .desc = La neblina de una cascada. ¡Podría haber algo detrás!
    .suffix = AU14, construcción Z, derrumbe

ent-AU14CollapseRockProp = tormenta de rocas
    .desc = Son rocas que caen del cielo.
    .suffix = AU14, construcción Z, derrumbe

ent-AU14RockDebris = escombros de roca
    .desc = Un trozo de roca desprendido por un derrumbe.
    .suffix = AU14, construcción Z

ent-AU14StructuralScanner = escáner estructural
    .desc = Un escáner portátil que muestra la estabilidad de los techos excavados. Actívalo en la mano para ver dónde está a punto de derrumbarse una caverna.
    .suffix = AU14, construcción Z

ent-AU14NavalisSupportBeamAqua1Tile = viga de soporte de plastiacero
    .desc = Una viga de soporte de plastiacero. Es el soporte más resistente; hace falta una potencia de fuego considerable para derribarla.
    .suffix = AU14, construcción Z, 1 baldosa, plastiacero

ent-AU14NavalisSupportBeamBlue1Tile = viga de soporte de acero
    .desc = Una resistente viga de acero que sostiene la estructura superior. Destruirla derribará aquello que soporta.
    .suffix = AU14, construcción Z, 1 baldosa

ent-AU14NavalisSupportBeamBrown1Tile = viga de soporte de madera
    .desc = Una viga de soporte de madera. Es barata y débil; no soportará demasiado castigo.
    .suffix = AU14, construcción Z, 1 baldosa, madera

ent-AU14NavalisSupportBeamGreen1Tile = viga de soporte metálica
    .desc = Una viga de soporte de acero. Es una opción sólida y versátil que aguanta bastante castigo.
    .suffix = AU14, construcción Z, 1 baldosa, metal

ent-AU14TileApplierDirt = tierra
    .desc = Un aplicador temporal que coloca una capa de tierra y desaparece al terminar.
    .suffix = AU14, construcción Z, baldosa

ent-AU14TileApplierPlating = revestimiento
    .desc = Un aplicador temporal que coloca revestimiento metálico y desaparece al terminar.
    .suffix = AU14, construcción Z, baldosa

ent-AU14TileApplierSteel = suelo de acero
    .desc = Un aplicador temporal que coloca un suelo de acero y desaparece al terminar.
    .suffix = AU14, construcción Z, baldosa

ent-AU14TileFloorSupport = soporte de suelo
    .desc = Un marcador invisible que integra una baldosa en la estructura de soporte del nivel superior.
    .suffix = AU14, construcción Z, soporte de baldosa

ent-AU14ZStairDown = escaleras de nivel Z (abajo)
    .desc = Un hueco de escalera que baja un nivel Z. Abre aquí un pozo, genera el nivel inferior y coloca allí una escalera de regreso.
    .suffix = AU14, construcción Z

ent-AU14ZStairPure = escalera de nivel Z
    .desc = Una escalera que conecta dos niveles Z. Camina sobre ella para pasar de uno a otro sin interrupciones.
    .suffix = AU14, construcción Z, complementaria

ent-AU14ZStairUp = escaleras de nivel Z (arriba)
    .desc = Una escalera que sube un nivel Z. Coloca arriba una plataforma estable con un pozo abierto y aquí una viga de soporte.
    .suffix = AU14, construcción Z
