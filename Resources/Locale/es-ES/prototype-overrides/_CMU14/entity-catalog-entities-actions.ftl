# Campos efectivos de prototipos localizados para es-ES.
# Los identificadores ent-* son contratos del motor y no se traducen.

ent-ActionApeHeadbite = mordisco a la cabeza
    .desc = Un mordisco a la cabeza específico de simios que aplica el efecto de mordisco a blancos inconscientes.

ent-ActionApeLeap = Salto
    .desc = Salta hacia un lugar determinado y derriba al primer enemigo alcanzado.

ent-ActionApeRam = embestir
    .desc = Una embestida específica para simios. Selecciona a un enemigo para embestirlo a cambio de una pequeña cantidad de plasma.

ent-ActionBlackfootAscendZLevel = Ascenso del Blackfoot
    .desc = Haz que el Blackfoot ascienda un nivel Z.

ent-ActionBlackfootDescendZLevel = Descenso del Blackfoot
    .desc = Haz descender el Blackfoot un nivel Z.

ent-ActionBlackfootDoorGunZModeToggle = alternar el Z-Fire del M866
    .desc = Alterna el M866 entre disparar en el nivel Z actual y disparar un nivel hacia abajo.

ent-ActionBlackfootEngineToggle = alternar los motores del Blackfoot
    .desc = Arranca o detén los motores del Blackfoot.

ent-ActionBlackfootFlightModeToggle = alternar el modo de vuelo Blackfoot
    .desc = Alterna entre vuelo estacionario VTOL y vuelo hacia delante.

ent-ActionBlackfootLand = aterrizaje del Blackfoot
    .desc = Inicia la secuencia de aterrizaje VTOL.

ent-ActionBlackfootRearDoorToggle = Alternar puerta trasera del Blackfoot
    .desc = Abre o cierra la puerta trasera del Blackfoot.

ent-ActionBlackfootStowToggle = guardar Blackfoot
    .desc = Pliega o despliega el Blackfoot mientras está en tierra.

ent-ActionBlackfootTakeoff = Despegue del Blackfoot
    .desc = Inicia la secuencia de despegue VTOL.

ent-ActionMarineGovforSilence = Emitir orden: silencio
    .desc = Ordena silencio en la zona. El personal cercano solo puede susurrar durante 15 segundos.

