ent-AU14BootsCBRN = botas MOPP M3
    .desc = Las botas M3 MOPP se han diseñado para proteger del contacto con posibles vectores de infección o sustancias peligrosas que hayan contaminado la zona de operaciones. Incorporan mejoras adicionales a la durabilidad estándar de las botas M3, lo que reduce la probabilidad de perforaciones o cortes y los efectos de la radiación.
    .suffix = lleno

ent-AU14BootsJungle = Botas de jungla
