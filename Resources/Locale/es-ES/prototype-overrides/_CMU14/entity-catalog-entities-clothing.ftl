ent-AU14PouchConstructionFilled = bolsillo de construcción
    .desc = Está diseñado para guardar materiales de construcción: láminas de vidrio o metal, varillas metálicas, alambre de espino, bobinas de cable y sacos de arena vacíos. También tiene dos ganchos para una herramienta de zapador y un sustituidor de luces.
    .suffix = AU14, lleno, colono

ent-AU14PouchElectronicsFilled = Bolsillo de electrónica
    .desc = Está diseñado para contener la mayoría de aparatos electrónicos, células de energía y placas de circuito.
    .suffix = AU14, lleno, colono

ent-AU14PouchFirstResponderFilled = Bolsillo de primera intervención
    .desc = Un bolsillo diseñado para llevar suministros con los que ayudar al personal médico y responder con rapidez a las heridas en el campo de batalla sin tratarlas de inmediato. Puede contener camillas con ruedas, bolsas de estasis y analizadores de salud.
    .suffix = AU14, lleno, colono

ent-AU14PouchGeneralLargeLEOFilled = Bolsillo general grande
    .desc = Un bolsillo de uso general para llevar más objetos de distintos tamaños.
    .suffix = AU14, lleno, LEO

ent-AU14PouchMedicalFilled = bolsa médica
    .desc = Puede transportar suministros médicos pequeños.
    .suffix = AU14, lleno, colono

ent-AU14PouchPistolAlt = bolsa para arma secundaria
    .desc = Podrías llevar una pistola aquí; más importante aún, podrías desenfundarla con rapidez. Útil para emergencias.
    .suffix = AU14, negro

ent-AU14PouchShotgunLargeBuckshot = Bolsillo grande para cartuchos de escopeta
    .desc = Puede contener más puñados de cartuchos.
    .suffix = AU14

ent-AU14SpikeBoots = botas de asalto M-19 «Treadnailer»
    .desc = Botas de asalto de alta resistencia con placas de púas endurecidas de carburo de tungsteno soldadas a presión en la suela. Se diseñaron originalmente como prototipo para operaciones en terrenos disputados y asaltos de brecha en espacios cerrados. El conjunto de púas está homologado para perforar blindaje blando estándar a distancia de contacto y eliminar con extrema contundencia obstáculos orgánicos bajo los pies. Reduce aproximadamente un 20% la velocidad normal de movimiento con carga operativa completa. Tener cuidado cerca de aliados abatidos.
    .suffix = AU14

ent-AU14WebbingAdminPouch = Bolsillo de administrador
