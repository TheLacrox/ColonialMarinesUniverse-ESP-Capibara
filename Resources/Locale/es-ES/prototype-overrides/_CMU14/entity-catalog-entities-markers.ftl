ent-CMUDecalSpawnerGrassTemperate = generador de calcomanías
    .suffix = hierba

ent-CMURandomWildernessSpawner = generador de entorno silvestre aleatorio
    .suffix = bosque

ent-CMURandomWildernessSpawnerNoTrees = generador de entorno silvestre aleatorio
    .suffix = zona boscosa, sin árboles

