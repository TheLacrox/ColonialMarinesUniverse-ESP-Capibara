# Campos efectivos de prototipos localizados para es-ES.
# Los identificadores ent-* son contratos del motor y no se traducen.

ent-CMUSpawnMobCarp = generador de carpa

ent-CMURuinedDroneCore = núcleo de dron arruinado
    .desc = El núcleo de control chamuscado de un androide dron destruido. Ahora solo sirve como prueba.

ent-ActionCarpRam = embestir
    .desc = Lanza al enemigo seleccionado unas casillas, lo derriba y le causa daño.

ent-ActionCarpTailLash = latigazo de cola
    .desc = Tras un doafter muy breve, lanza hacia atrás a los enemigos de una zona de 2x3 en la dirección seleccionada. También ralentiza.

ent-ActionCarpTumble = voltereta
    .desc = Carga hacia un lado y empuja al primer enemigo alcanzado. Solo puede usarse hacia cualquiera de los lados con respecto a la dirección en la que miras.

ent-CMUMobCarpInvasive = Carpa invasora
    .desc = Es una especie invasora de carpa. Se ha adaptado para cazar cuesta arriba en ambas direcciones.
    .suffix = CMU

ent-AU14MobK9 = K9 sintético
