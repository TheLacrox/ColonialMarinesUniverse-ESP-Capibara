ent-AU14GrenadeNeuroGas = gas nervioso CN20

ent-AU14UADeskFlag = bandera de escritorio de UA
    .desc = Una bandera de sobremesa de las Américas Unidas.

ent-AU14USCMDeskFlag = bandera de escritorio USCM
    .desc = Una bandera de escritorio del Cuerpo de Marines Coloniales de los Estados Unidos.

ent-AUMetalIngot = lingote de metal
    .desc = Un lingote tosco de metal fundido, listo para seguir procesándolo.

ent-AUWeylandYutaniDoorknob = pomo de puerta Weyland-Yutani
    .desc = Un pomo mecanizado con precisión y estampado con el logotipo de Weyland-Yutani.

ent-AU14FloodlightBroken = foco alto averiado
    .desc = Una nota pegada dice: «Para arreglarlo, desatornilla el panel, saca el conjunto dañado con una palanca, suéldalo, añade 2 cables y vuelve a cerrar el panel».
    .suffix = AU14

ent-AU14Streetlight = farola colonial
    .desc = Un pilar de luz en la oscuridad.
    .suffix = AU14

ent-AU14StreetlightBroken = farola colonial rota
    .desc = Una nota pegada dice: «Para arreglarlo, desatornilla el panel, saca el conjunto dañado con una palanca, suéldalo, añade 2 cables y vuelve a cerrar el panel».
    .suffix = AU14

