# Campos efectivos de prototipos localizados para es-ES.
# Los identificadores ent-* son contratos del motor y no se traducen.

ent-ANPRC117GRadio = AN/PRC-117G
    .desc = Una radio de mochila multibanda reforzada, el salvavidas entre un pelotón sobre el terreno y su red de mando. Pesada, sobrediseñada y absolutamente indispensable. Los operadores de radiotelefonía suelen llevarla.

