    .desc = Sí, es un árbol.

ent-CMUFloraTreeLarge =
    .desc = Sí, es un árbol.

ent-AU14AdminConsole = consola de administración de la colonia
    .desc = El terminal del administrador colonial. Permite fijar los tipos del impuesto sobre las ventas y coordinar el apoyo de terceros. Todos los cambios se anuncian en toda la colonia.
    .suffix = colonia, administrador

ent-AU14AllianceConsoleGovfor = consola de alianzas (GovFor)
    .desc = Un terminal de mando de GovFor para gestionar la relación diplomática con facciones terceras.
    .suffix = GovFor

ent-AU14AllianceConsoleOpfor = Consola de alianzas (OpFor)
    .desc = Un terminal de mando de OpFor para gestionar las relaciones diplomáticas con facciones externas.
    .suffix = OpFor

ent-AU14AmbassadorConsoleIS = consola diplomática de la ICSC
    .desc = Una consola diplomática de las Colonias Independientes de Sistemas Centrales.
    .suffix = ICSC, PMC

ent-AU14AmbassadorConsoleTWE = consola diplomática de TWE
    .desc = Una consola diplomática del Imperio de los Tres Mundos. Puede solicitar apoyo de la NSPA o de los Marines Reales.
    .suffix = TWE, PMC

ent-AU14AmbassadorConsoleUA = consola diplomática de la UA
    .desc = Una consola diplomática de las Américas Unidas. Permite solicitar apoyo del Ejército de los Estados Unidos o de VAI.
    .suffix = UA, ejército

ent-AU14AmbassadorConsoleUPP = consola diplomática de UPP
    .desc = Una consola diplomática de la Unión de Pueblos Progresistas. Puede solicitar apoyo de las fuerzas especiales GROM.
    .suffix = UPP, GROM

ent-APOLLOAICoreProcessor = procesador APOLLO
    .desc = Un procesador externo para APOLLO, utilizado para procesar enormes cantidades de información.

ent-AU14AICoreCPU = CPU de APOLLO
    .desc = Este es el procesador central de APOLLO. La CPU tiene una carcasa diseñada para resistir explosiones nucleares y también contiene el registrador de caja negra de APOLLO.

ent-AU14AICoreSubstrate = Sustrato APOLLO
    .desc = El sustrato de memoria de APOLLO, que contiene protocolos e información complejos. Algunas funciones limitadas pueden operar solo con el sustrato, sin que la unidad principal APOLLO esté activa.

ent-AU14AreaGAAI = interfaz central de A.I. APOLLO

ent-AU14ChairComfyAI = Silla de interfaz de la I.A. central APOLLO
    .desc = Una silla funcional diseñada para que una persona se siente cómodamente y pueda interactuar con la IA de la nave.
    .suffix = AU14, APOLLO

ent-AU14CashDrinkMachine = Refrescos WY
    .desc = Un dispensador de bebidas de la marca Weyland-Yutani. Introduce dinero para comprar una bebida. Los precios están sujetos al impuesto colonial sobre las ventas.
    .suffix = Efectivo, bebidas

ent-AU14CashSnackMachine = provisiones de WY
    .desc = Un dispensador de tentempiés de la marca Weyland-Yutani. Introduce dinero para comprar uno. Los precios están sujetos al impuesto colonial sobre las ventas.
    .suffix = efectivo, aperitivos

ent-AU14CashVendorCigarettes = Máquina de Cigarrillos WY
    .desc = Una máquina expendedora de cigarrillos de la marca Weyland-Yutani. Introduce dinero para comprar productos de tabaco.
    .suffix = efectivo, cigarrillos

ent-AU14CashVendorGames = Rec-Vend WY
    .desc = Una máquina expendedora recreativa de Weyland-Yutani. Introduce dinero para comprar casetes, cartas, revistas y más.
    .suffix = efectivo, juegos

ent-AU14CashVendorHotDrinks = bebidas calientes WY
    .desc = Una máquina de bebidas calientes de la marca Weyland-Yutani. Introduce dinero para comprar café, té o cacao.
    .suffix = efectivo, bebidas calientes

ent-AU14CashVendorKitchenware = vajilla WY
    .desc = Una máquina expendedora de equipo de cocina y restauración de Weyland-Yutani. Introduce dinero para comprar utensilios de cocina.
    .suffix = Efectivo, utensilios de cocina

ent-AU14CashVendorLawEnforcement = SecTech WY
    .desc = Una máquina expendedora de equipo policial de Weyland-Yutani. Introduce dinero o utiliza el presupuesto del departamento para comprar suministros de seguridad.
    .suffix = efectivo, fuerzas del orden

ent-AU14CashVendorMedicalGeneral = WY-Med General
    .desc = Una máquina expendedora médica general de Weyland-Yutani con suministros de campaña y autoinyectores. Introduce dinero o utiliza el presupuesto del departamento.
    .suffix = efectivo, medicina general

ent-AU14CashVendorMedicalPharmacy = Farmacia WY-Chem
    .desc = Una máquina expendedora de farmacia de Weyland-Yutani, abastecida con botes de pastillas, medicamentos líquidos y suministros de química. Introduce dinero o utiliza el presupuesto del departamento.
    .suffix = Efectivo, farmacia

ent-AU14CashVendorMedicalSurgery = WY-Med Surgical
    .desc = Una máquina expendedora de suministros quirúrgicos de Weyland-Yutani. Introduce dinero o utiliza el presupuesto del departamento para comprar equipo quirúrgico y suministros para tratar heridas.
    .suffix = efectivo, cirugía

ent-AU14CashVendorPreparedMeals = Provisiones ColMarTech
    .desc = Una máquina expendedora de comida ColMarTech que dispensa comidas militares preparadas estándar y petacas. Introduce dinero para comprar.
    .suffix = efectivo, comidas preparadas

ent-AU14CashVendorSnackMachine = Comidas calientes WY
    .desc = Una máquina de aperitivos de Weyland-Yutani provista de alimentos envasados. Introduce dinero para comprar un aperitivo.
    .suffix = efectivo, aperitivos

ent-AU14CashVendorSodas = Souto Softdrinks
    .desc = Una máquina expendedora de refrescos de Souto Soda Company. Introduce dinero para comprar una bebida fría.
    .suffix = Efectivo, refrescos

ent-AU14CashVendorTools = expendedor de herramientas de WY
    .desc = Una máquina expendedora de herramientas de marca Weyland-Yutani. Introduce dinero para comprar herramientas y equipo.
    .suffix = efectivo, herramientas

ent-CMUCashVendorCircuits = Máquina expendedora de placas de circuitos
    .desc = Un almacenamiento seguro para placas de circuito preprogramadas. Cuenta con un giroscopio interno que impide que las fuerzas externas muevan las placas, un aislamiento grueso y un puerto UPS personalizado de 2.1mm para cargar diversos dispositivos exclusivos de We-Yu —se venden por separado—.
    .suffix = efectivo

ent-RMCChemStorageGroundWeYu = sistema de almacenamiento de productos químicos
    .desc = Sistema de almacenamiento para una gran reserva de sustancias químicas que se recarga lentamente.
    .suffix = suelo, WeYu

ent-AU14CorporateASRSConsole = consola corporativa de suministros
    .desc = Un terminal corporativo de Weyland-Yutani para gestionar suministros. Los pedidos realizados aquí están sujetos al tipo vigente del impuesto sobre las ventas.
    .suffix = corporativo, ASRS

ent-AU14CorporateASRSElevator = Ascensor corporativo de suministros
    .desc = Un ascensor corporativo de suministros de Weyland-Yutani. Entrega los pedidos realizados mediante el sistema de suministros corporativo.
    .suffix = corporativo, ASRS

ent-AU14CorporateConsole = consola de asuntos corporativos
    .desc = Terminal de asuntos corporativos de Weyland-Yutani. Permite fijar tarifas de tránsito, administrar fondos corporativos y coordinar el apoyo corporativo de terceros. Todos los cambios de tarifas se anuncian en toda la colonia.
    .suffix = Corporativo, WY

ent-CMUColonyRosterConsole = Consola de residentes de la colonia
    .desc = Muestra expedientes de los residentes de la colonia.
    .suffix = colonia

ent-CMUGovforRosterConsole = consola de personal de GOVFOR
    .desc = Enumera los expedientes del personal de GOVFOR.
    .suffix = GOVFOR

ent-CMUOpforRosterConsole = consola de personal OPFOR
    .desc = Enumera los expedientes del personal de OPFOR.
    .suffix = OPFOR

