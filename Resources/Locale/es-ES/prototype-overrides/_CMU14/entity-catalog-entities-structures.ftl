ent-CMUPodDoorButtonAdjutantLock = Control de persianas de la armería
    .desc = Un botón que se bloquea en posición abierta por sí solo si el mando no se presenta para accionarlo.
    .suffix = GOVFOR, armería

ent-CMUShutterHybrisaAdjutantLock = Persianas de la armería
    .desc = Un conjunto de persianas pesadas diseñadas para mantener segura la armería. Pueden abrirse con un botón situado en el CIC. Si el mando no está despierto para abrirlas, se abrirán solas al cabo de un tiempo.
    .suffix = GOVFOR

ent-CMUShutterLamentOpen = compuertas
    .desc = Parece que no se abre con facilidad.
    .suffix = Abierto

