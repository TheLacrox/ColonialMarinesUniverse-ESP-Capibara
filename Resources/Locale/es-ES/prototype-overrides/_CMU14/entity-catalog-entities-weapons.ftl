ent-AU14AttachmentTwoPointSling = correa de dos puntos
    .desc = Una tira tradicional de tejido de nailon endurecido con enganches en ambos extremos para sujetarla a los puntos de montaje apropiados de la mayoría de armas largas.

ent-AU14BulletRifleMAR40AP = BaseBullet
    .desc = ¡Si puedes ver esto, probablemente estés muerto!

ent-AU14CartridgeRifleMAR40AP = cartucho (7.62x39mm AP)
    .desc = Un cartucho perforante de fusil 7.62x39mm.

ent-AU14MagazineMar50LMGAP = cargador de tambor AP MAR (7.62x39mm)
    .desc = Un cargador de tambor de 7.62x39mm para la ametralladora ligera MAR-50.

ent-AU14WeaponMar50LMGTactical = ametralladora ligera MAR-50
    .desc = Una ametralladora ligera barata y fiable, calibrada para 7.62x39mm. Suele encontrarse en manos de delincuentes con algo más de financiación.

ent-AU14TeleBaton = porra telescópica
    .desc = Una porra telescópica para incapacitar personas.

ent-AU14ToolMachete = machete
    .desc = Ábrete paso entre junglas densas y vegetación espesa con esta brutal hoja. Una de las favoritas tanto de marines como de caudillos.
    .suffix = AU14

ent-AU14ToolPickaxe = Pico
    .desc = Ideal para presentar las rocas a la gravedad y lo bastante pesada para convencer hasta a la piedra más dura de que se aparte.
    .suffix = AU14

ent-AU14ToolShovel = pala
    .desc = Una herramienta grande para cavar y mover tierra.
    .suffix = AU14

ent-AU14WeaponRevolverM2019 = revólver automático M2019 'blaster'
    .desc = Un revólver entregado originalmente a las fuerzas del orden a principios del siglo XXI, utilizado sobre todo por los ahora extintos Blade Runners durante el apogeo de la crisis de los Replicantes a comienzos de la década de 2000. Recamarada en .357, el arma quedó obsoleta hace mucho, pero sigue siendo popular entre coleccionistas y «fudds». A lo largo de las décadas han aparecido numerosas reproducciones, algunas fieles y otras peligrosamente baratas. Aunque no es habitual, tampoco resulta inaudito ver una en una funda a la cadera en los mundos fronterizos de la UA y el TWE.

ent-AU14WeaponRevolverM2019Empty = revólver automático M2019 'blaster'
    .desc = Un revólver entregado originalmente a las fuerzas del orden a principios del siglo XXI, utilizado sobre todo por los ahora extintos Blade Runners durante el apogeo de la crisis de los Replicantes a comienzos de la década de 2000. Recamarada en .357, el arma quedó obsoleta hace mucho, pero sigue siendo popular entre coleccionistas y «fudds». A lo largo de las décadas han aparecido numerosas reproducciones, algunas fieles y otras peligrosamente baratas. Aunque no es habitual, tampoco resulta inaudito ver una en una funda a la cadera en los mundos fronterizos de la UA y el TWE.
    .suffix = vacío

ent-AU14WeaponPistolRXFM5 = pistola láser EVA RXF-M5
    .desc = Una pistola láser de enfoque y alta potencia con batería nuclear interna, diseñada para actividad extravehicular. Aunque, en realidad, funciona casi en cualquier parte. Deriva de la misma tecnología que los soldadores láser. La suministra Weyland-Yutani Corporation, pero también está disponible en el mercado civil.
    .suffix = WE-YU

ent-AU14WeaponRifleABR40TacticalVAI = Fusil de caza táctico ABR-40
    .desc = La versión civil del fusil de batalla L42A que suelen empuñar los Marines. Es casi idéntico e incluso compatible con cargadores L42, pero no le quites la culata. Este fusil parece llevar un exclusivo mobiliario táctico azul negruzco y varias modificaciones posventa.
    .suffix = lleno, táctico

ent-AU14WeaponRifleAR10 = fusil AR10
    .desc = Un diseño antiguo y fiable. Algo así debería estar en un museo de historia militar. Está recamarado en 5.56x45mm.
    .suffix = lleno

ent-AU14WeaponRifleM16A1 = fusil M16A1
    .desc = Un diseño antiguo y fiable, adoptado por primera vez por el ejército estadounidense en la década de 1960. Algo así debería estar en un museo de historia militar. Está recamarado en 5.56x45mm.
    .suffix = lleno

ent-AU14WeaponRifleM16A2 = fusil M16A2
    .desc = Un diseño antiguo y fiable, adoptado por primera vez por el ejército estadounidense en la década de 1980. Algo así debería estar en un museo de historia militar. Está calibrado para 5.56x45mm.
    .suffix = lleno

ent-AU14WeaponRifleM16A2Larue = Fusil M16A2 Larue
    .desc = Un patrón «mejorado» de M16A2 recién lanzado al mercado civil, anunciado como «modularidad de vanguardia y compatibilidad con miras a bajo coste». Tuvo un éxito limitado en el mercado previsto, aunque desde entonces mantiene ventas escasas pero estables.
    .suffix = lleno

ent-AU14WeaponRifleM41AMK2Tactical = Fusil de pulsos M41A MK2
    .desc = El fusil reglamentario de la UA. Lo lleva habitualmente la mayoría del personal de combate. Utiliza munición sin vaina de 10x24mm.
    .suffix = lleno, táctico

ent-AU14MagazineRifleM41AE2 = cargador AP M41AE2 (10x24mm)

ent-AU14WeaponRifleM41AE2Tactical = fusil de pulsos pesado M41AE2
    .desc = Una gran arma de apoyo de pelotón capaz de mantener fuego de supresión desde una posición montada. Aunque resulta inestable y menos precisa, puede transportarse y dispararse con ambas manos.
    .suffix = lleno, táctico

ent-AU14WeaponRifleM41AMK1Tactical = Fusil de pulsos M41A MK1
    .desc = Un diseño anterior del Pulse Rifle utilizado habitualmente por el Cuerpo de Marines. Utiliza munición sin vaina de 10x24mm.
    .suffix = lleno, táctico

ent-AU14WeaponRifleMAR30Tactical = carabina de batalla MAR-30
    .desc = Una carabina barata y fiable, calibrada para 7.62x39mm. Suele encontrarse en manos de criminales o mercenarios.
    .suffix = lleno, táctico

ent-AU14WeaponRifleMAR40Tactical = fusil de combate MAR-40
    .desc = Un fusil de asalto barato y fiable, calibrado para 7.62x39mm. Suele encontrarse en manos de criminales o mercenarios, o de la UPP o la CLF. Este lleva un contador de munición posventa.
    .suffix = lleno, táctico

ent-AU14BulletRifleTwoBore = BaseBullet
    .desc = ¡Si puedes ver esto, probablemente estés muerto!

ent-AU14CartridgeRifleTwoBore = cartucho de fusil (Two-Bore)
    .desc = Un cartucho de fusil Two-Bore. Este proyectil hace que un .50 Cal parezca un tirachinas. Reza para que nunca te alcance.

ent-AU14WeaponRifleTwoBore = Fusil Double-Deuce Two-Bore
    .desc = Un fusil de dos cañones de calibre Two-Bore fabricado a medida. Construido para cazar las presas más grandes —o peligrosas—. Pesa cuarenta y cinco libras en vacío, es ilegal en tres sectores y tiene un gatillo extremadamente sensible. Cuídala y ella cuidará de ti y de cualquier cosa a la que apuntes.

ent-AU14WeaponShotgunM890Tactical = escopeta táctica MK221
    .desc = Una escopeta semiautomática de Weyland-Yutani con alta cadencia y un lanzagranadas acoplado bajo el cañón. Aloja 8 cartuchos de escopeta en la recámara.
    .suffix = lleno, táctico

ent-AU14MagazineRifleM100MGR = cargador M100MGR (40mm)

ent-AUWeaponRifleM100MGR = M100 MGR
    .desc = Una plataforma lanzagranadas de explosión aérea diseñada para granaderos de sección de la CCAF, que sustituye al lanzador acoplado de los M41A. Dispara granadas de explosión aérea de 40mm alimentadas por cargador. Esta arma cuenta con IFF y aún se somete a pruebas de campaña limitadas en ciertas unidades de infantería de la CCAF.

ent-AU14BulletRifleC10A6BR = BaseBullet
    .desc = ¡Si puedes ver esto, probablemente estés muerto!

ent-AU14CartridgeRifleC10A6BR = Cartucho (.25 ACP)
    .desc = Un cartucho de pistola .25 ACP

ent-AU14MagazineRifleC10A6BR = cargador C10A6BR (.25 ACP)

ent-AUWeaponRifleC10A6BR = C10A6-BR 'Sundog'
    .desc = Un fusil de ráfaga refleja diseñado para la CCAF por Armat Battlefield Systems. Al apretar el gatillo dispara una rápida ráfaga de tres cartuchos, todos antes de que el operador perciba el retroceso. El arma sigue sometida a pruebas de campo limitadas en ciertas unidades de infantería de la CCAF.

ent-AU14BulletRifleM75AMAS = BaseBullet
    .desc = ¡Si puedes ver esto, probablemente estés muerto!

ent-AU14CartridgeRifleM75AMAS = Cartucho (10x24mm)
    .desc = Un cartucho de fusil de 10x24mm.

ent-AU14MagazineRifleM75AMAS = cargador M75AMAS (10x24mm)

ent-AUWeaponRifleM75AMAS = M75A MAS
    .desc = El M75A MAS es la plataforma de armas modular más reciente de Armat Battlefield Systems y pretende sustituir al anticuado fusil de pulsos M41 MK1. Aún se somete a pruebas de campaña limitadas en ciertas unidades de infantería de la CCAF.

ent-AU14FuelM240A2FuelTankFilled = depósito de combustible G4-1 de pirotécnico marine
    .desc = Un aparejo para la espalda de una generación mucho más antigua, con dos depósitos de combustible. Entre ambos hay un pequeño regulador. Cuenta con varias correas para sujetar hasta tres depósitos de lanzallamas que podrás rellenar.
    .suffix = HAZOPS

ent-AU14TankFlamerM240A2HAZOPS = depósito de incinerador pesado M240A2
    .desc = Un depósito pesado de gran capacidad utilizado por la M240A2. Lleva impreso en un lateral un logotipo incoloro de HAZOPS.

ent-AU14TankFlamerM240A2HAZOPSNapalmB = depósito de incinerador pesado M240A2 (B)
    .desc = Un depósito pesado y de gran capacidad utilizado por la M240A2. Lleva un logotipo incoloro de HAZOPS estampado en un lateral. Parece contener «Napalm-B».

ent-AU14TankFlamerM240A2HAZOPSNapalmX = Depósito de incinerador pesado M240A2 (X)
    .desc = Un depósito pesado de gran capacidad utilizado por la M240A2. Lleva impreso en un lateral un logotipo incoloro de HAZOPS. Este parece contener «Napalm-X».

ent-AU14WeaponFlamerM240A2HAZOPS = unidad incineradora pesada M240A2
    .desc = La respuesta del USCMC al Flammerwerfer 3 de WY. Mucho más eficaz que el M240 estándar, pero penaliza el movimiento. Suele suministrarse a HAZOPS.

ent-AU14BulletMinigunHAZOPS9mm = Bala (9mm)
    .desc = ¡Si puedes ver esto, probablemente estés muerto!

ent-AU14CartridgeMinigunHAZOPS9mm = cartucho (9mm)

ent-AU14MagazineMinigunHAZOPS = cargador de tambor GAU-19/H (9mm)

ent-AU14SmartGunMinigunHAZOPS = Minigun portátil GAU-19/H
    .desc = Una bestia de arma. Esta minigun, antaño montada en soportes de aeronaves, se ha adaptado para llevarla en las manos, aunque no fue posible incorporar sistemas IFF con seguridad. Ofrece una cadencia y una capacidad de munición incomparables, pero hubo que reducir el calibre para que resultara manejable, por lo que carece de capacidad perforante y de potencia de parada.

ent-AU14CartridgePistol50JP = .50 JP

ent-AU14MagazinePistolM50 = cargador para cañón de mano M50 Bald Eagle (.50 JP)
    .desc = Un cargador de pistola.

ent-AU14WeaponPistolM50HAZOPS = cañón de mano M50 «Bald Eagle»
    .desc = Fabricada por Armat para celebrar el próximo 400.º aniversario de los Estados Unidos, esta pistola dispara proyectiles .50 AE propulsados a reacción que causan mucho daño y pueden perforar armaduras. A HAZOPS le encanta por combinar movilidad con un gran daño. Hay que amartillarla después de cada cargador.
    .suffix = lleno

ent-CMBulletPistol50JP = Proyectil .50 AE propulsado a reacción
    .desc = ¡Si puedes ver esto, probablemente estés muerto!

ent-AU14MagazineRifleXM20A2 = cargador XM20A2 (10x24mm)

ent-AUWeaponRifleXM20A2HAZOPS = fusil de pulsos XM20A2
    .desc = Desarrollado como posible sucesor del fusil M20A Harrington, el XM20A2 nunca entró en servicio completo en el USCM y fue reemplazado por el M41. Esta variante muy modificada se suministra a HAZOPS para reforzar su capacidad a media y larga distancia. Tiene un gran cargador y una gran cadencia, pero los tambores solo admiten munición estándar de 10x24mm y los rieles no permiten acoplar accesorios modernos.

ent-AU14WeaponShotgunSPAS12HAZOPS = SPAS-12-HAZ
    .desc = Diseñada para equipos HAZOPS, esta SPAS-12 recortada se parece mucho a los antiguos modelos terrestres, pero sus mecanismos internos se han reconstruido por completo para ofrecer un devastador modo de «disparo triple».

ent-AU14AttachmentM203A4GrenadeLauncher = Lanzagranadas M203A4
    .desc = Un lanzagranadas recargable montado en el arma.

ent-AU14MagazineXMP5A6 = cargador XMP5A6 (10x24mm)
    .desc = ¿Qué han hecho con mi cargador banana? Utiliza 10x24mm.

ent-AU14WeaponSMGXMP5A6HAZOPS = XMP5A6/10 CQW
    .desc = Ganador del programa de armas de corto alcance de HAZOPS de 2172, este «subfusil» de origen alemán responde a la pregunta: «¿Qué pasaría si metiéramos el calibre del fusil estándar del USCMC en una pistola ametralladora?». Pese a su poca precisión, tiene una cadencia elevada y una potencia de parada impresionante. Calibrado para 10x24mm. Admite cargadores M41A.

ent-AU14WeaponRifleKramerLSW = arma ligera de apoyo Kramer
    .desc = También conocida como Kramer o KAR, el arma ligera de apoyo Kramer es una variante automática de apoyo de pelotón del fusil de asalto Kramer estándar. Fabricada por Kramer Metallarbeiten GmbH, la KAR se utiliza ampliamente por todas las Américas Unidas.

ent-AU14WeaponRifleKramerLSWAP = arma ligera de apoyo Kramer (AP)
    .desc = También conocida como Kramer o KAR, el arma ligera de apoyo Kramer es una variante automática de apoyo de pelotón del fusil de asalto Kramer estándar. Fabricada por Kramer Metallarbeiten GmbH, la KAR se utiliza ampliamente por todas las Américas Unidas.

