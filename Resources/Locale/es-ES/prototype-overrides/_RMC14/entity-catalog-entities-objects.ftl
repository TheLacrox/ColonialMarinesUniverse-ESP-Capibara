ent-RMCCatClock = reloj de gato
    .desc = Un reloj de gato increíblemente siniestro que vigila la estancia con cada tic y cada tac.

ent-RMCDigitalClock = reloj digital
    .desc = Un reloj a pilas capaz de mantener la hora con un margen de unos 5 segundos... Nunca fue tan preciso.

ent-RMCGoldClock = reloj dorado
    .desc = Un reloj ostentoso para demostrar a los demás lo rico que eres.

ent-RMCWoodClock = reloj de madera
    .desc = Un reloj corriente para ver la hora.

ent-RMCCorrespondentMicrophone = micrófono
    .desc = Para informar de acontecimientos adonde ningún otro corresponsal ha llegado antes. ¡Ahora con sonido!
    .suffix = RMC

ent-CMAPCElectronics = módulo de control de energía
    .desc = Circuito utilizado para construir APC.
