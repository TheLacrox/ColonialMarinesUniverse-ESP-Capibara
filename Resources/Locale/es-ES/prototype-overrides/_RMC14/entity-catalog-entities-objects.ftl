ent-RMCAdminAccessConfigurator = configurador de acceso administrativo
    .desc = Si lo encuentras, devuélvelo al oficial del Alto Mando más cercano.
    .suffix = RMC, administrador

ent-RMCToolHatchet = hachuela
    .desc = Un hacha de mano afilada que suele utilizarse para cortar cosas, ya sea madera u otros objetos. A menudo se encuentra en manos de leñadores, exploradores y saqueadores.

ent-RMCToolMiniHoe = azada pequeña
    .desc = Sirve para arrancar malas hierbas o rascarte la espalda.

ent-RMCToolSpade = pala de zapador
    .desc = Una pequeña herramienta para cavar y mover tierra.

ent-CMBucketMop = cubo de fregona
    .desc = Un cubo más grande, usado normalmente con una fregona. Admite 240 unidades.

ent-RMCBucketJanitorial = cubo de conserjería
    .desc = Es un cubo grande que cabe en un carro de limpieza. Admite 500 unidades.

ent-RMCReagentJug = jarra de reactivos
    .desc = Una garrafa grande de plástico no reactivo, capaz de transportar grandes cantidades de diversas sustancias químicas allí donde se necesiten. Admite 500 unidades.

ent-CMEntrenchingTool = herramienta de atrincheramiento
    .desc = Sirve para cavar hoyos y partir cabezas. Se pliega para caber en espacios pequeños.

ent-CMFireExtinguisherPortable = extintor portátil
    .desc = Un extintor ligero y compacto con armazón de fibra de vidrio.

ent-RMCExtinguisherSpray = aerosol extintor

ent-RMCExtinguisherSpraySpec = aerosol extintor

ent-CMPackFlare = Paquete de bengalas de marcación M94
    .desc = Un paquete de ocho bengalas de señalización M94. Los soldados de los Marines las llevan para iluminar zonas oscuras a las que no llega la lámpara de hombro TNR habitual.
    .suffix = lleno

ent-RMCAirFlare = bengala aérea

ent-RMCAirFlareCAS = Bengala aérea de señalización

ent-RMCAirFlareL96 = bengala aérea

ent-RMCBoxPackFlare = caja de paquetes de bengalas M94 (x10)
    .desc = Una caja de paquetes de bengalas de señalización M94 para alegrarte el día.
    .suffix = lleno

ent-RMCBoxPackFlareCAS = Caja de paquetes de bengalas M89-S (x10)
    .desc = Una caja de paquetes de bengalas de señalización M89 para marcar el camino.
    .suffix = lleno

ent-RMCBoxPackFlareCASEmpty = Caja de paquetes de bengalas M89-S (x10)
    .desc = Una caja de paquetes de bengalas de señalización M89 para marcar el camino.

ent-RMCBoxPackFlareEmpty = caja de paquetes de bengalas M94 (x10)
    .desc = Una caja de paquetes de bengalas de señalización M94 para alegrarte el día.

ent-RMCFlareBullet = Proyectil de bengala
    .desc = ¡Si puedes ver esto, probablemente estés muerto!

ent-RMCFlareCAS = bengala de señalización
    .desc = Una bengala de señales verde suministrada por la UNMC. El ordenador de telemetría funciona mediante una reacción química que libera humo y luz, por lo que solo opera mientras arde la bengala.

ent-RMCFlareCASBullet = proyectil de bengala de señalización
    .desc = ¡Si puedes ver esto, probablemente estés muerto!

ent-RMCFlareL96Bullet = proyectil de bengala L96
    .desc = ¡Si puedes ver esto, probablemente estés muerto!

