ent-CMRadioHandheld = Radioteléfono de los Marines
    .desc = También conocido como walkie-talkie, este dispositivo permite comunicarse a larga distancia cuando fallan las telecomunicaciones.

ent-RMCTimerTrigger = temporizador
    .desc = Se usa para cronometrar cosas. Funciona bien con artilugios que necesitan una cuenta atrás. Tic, tac.
    .suffix = RMC

