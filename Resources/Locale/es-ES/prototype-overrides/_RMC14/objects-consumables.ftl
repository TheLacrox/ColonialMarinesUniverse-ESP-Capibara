# Bebidas calientes

ent-RMCDrinkCoffee = café
    .desc = Cuidado: la bebida que estás a punto de disfrutar está extremadamente caliente.
    .suffix = lleno

ent-RMCDrinkCoffeeGrind = café de tueste oscuro Cuppa Joe's
    .desc = ¡Arriba y a brillar! ¡Es hora de beber tu Cuppa Joe's!
    .suffix = lleno

ent-RMCDrinkTea = té Duke Purple
    .desc = ¡Un insulto al Duque Purple es un insulto a la Reina del Espacio! Cualquier caballero respetable te desafiará si mancillas este té.
    .suffix = lleno

ent-RMCDrinkTeaSPP = recipiente térmico
    .desc = Un recipiente térmico pequeño y reutilizable para líquidos, provisto de tapa con boquilla.
    .suffix = té

ent-RMCDrinkWaterSPP = recipiente térmico
    .desc = Un recipiente térmico pequeño y reutilizable para líquidos, provisto de tapa con boquilla.
    .suffix = agua

ent-RMCDrinkHotCocoa = chocolate caliente holandés
    .desc = Elaborado en la Sudamérica espacial.
    .suffix = lleno

# Tazas

ent-RMCCoffeeCup = taza
    .desc = Una taza de cerámica. Prácticamente garantizado que se caerá y derramará una bebida abrasadora sobre tu camisa nueva. Ay.
    .suffix = RMC

ent-RMCCoffeeCupFilled = taza
    .desc = Una taza de cerámica. Prácticamente garantizado que se caerá y derramará una bebida abrasadora sobre tu camisa nueva. Ay.
    .suffix = RMC, llena, RMCCoffee

ent-RMCMarineCorpsCup = taza de la UNMC
    .desc = Una resistente taza de especificaciones militares con la insignia de la UNMC, concebida para aguantar cualquier despliegue, ya sea a bordo de una nave o sobre el terreno.
    .suffix = RMC

ent-RMCSocialistPPCup = taza de la UPP
    .desc = Una resistente taza carmesí con el emblema de la UPP, hecha como un auténtico krepky muzhik y lista para acompañar a los camaradas en el trabajo y la gloria entre las estrellas.
    .suffix = RMC

ent-RMCUnitedNationsCup = taza de la UN
    .desc = Una elegante taza oficial de la UN, símbolo de unidad, orden y autoridad por todas las estrellas. Fabricada para quienes defienden la paz y el progreso.
    .suffix = RMC

ent-RMCWestonYamadaCup = taza de WEYA
    .desc = Una taza limpia y elegante con el logotipo de la Corporación Weyland-Yutani estampado en un lado. Se usa en toda la jerarquía de la empresa, desde becarios hasta directores de división.
    .suffix = RMC

ent-RMCThreeSunEmpireCup = taza del TSE
    .desc = Una taza elegante y bien confeccionada con el emblema del Imperio de los Tres Soles en un lado. Excelente para quienes sirven y viven bajo la Emperatriz y su Imperio.
    .suffix = RMC

ent-RMCColonyLiberationFrontCup = taza del CLF
    .desc = Una resistente taza muy gastada, marcada con el emblema del Frente de Liberación Colonial nacido del desafío que desató la Masacre de Xibou.
    .suffix = RMC

ent-RMCPaperCup = vaso de papel
    .desc = Un vaso de papel para agua.
    .suffix = RMC

# Vasos

ent-RMCPintGlass = vaso de pinta
    .desc = Un auténtico vaso de pinta para viejos parroquianos. Rara vez se ve sin una espumosa corona de cerveza.

ent-RMCPintGlassFull = vaso de pinta
    .desc = Un auténtico vaso de pinta para viejos parroquianos. Rara vez se ve sin una espumosa corona de cerveza.
    .suffix = lleno

ent-RMCDrinkGlass = vaso
    .desc = Un vaso corriente para beber.

# Botellas Weyland-Yutani

ent-CMDrinkWEYAWaterBottle30 = agua de manantial embotellada We-Yu
    .desc = Agua «de manantial» a precio desorbitado. Embotellada por la Corporación We-Yu.
    .suffix = llena

ent-RMCDrinkWEYABugJuice = bebida proteica Bug Juice de Weyland-Yutani
    .desc = Una botella de plástico de la marca We-Ya llena de una pringue verde de aspecto tóxico. Sabe a kiwi, pero estás más que seguro de que no contiene ninguno.
    .suffix = llena

ent-RMCDrinkWEYACocoMilk = leche de coco embotellada Weyland-Yutani
    .desc = Rica en vitaminas y sabor (artificial), calma la sed en unos pocos sorbos. Embotellada por la Corporación Weyland-Yutani.
    .suffix = llena

ent-RMCDrinkWEYASoylent = Soylent prémium de chocolate Weyland-Yutani
    .desc = Una botella de plástico repleta de deliciosa pringue con sabor a chocolate. Contiene suficientes calorías para una comida; no te la bebas de una sentada, más vale no arriesgarse a un dolor de estómago.
    .suffix = llena

# Raciones de combate

ent-CMMRE = MRE de la UNMC
    .desc = Una comida lista para consumir. Es una ración de combate para una sola comida, concebida para proporcionar a un soldado suficientes nutrientes durante una jornada de trabajo agotador. Caduca al menos 20 años después de tu esperanza de vida en combate.

ent-RMCBoxMREEmpty = caja de MRE (x12)
    .desc = Una caja de MRE. Nutritivas, pero nada deliciosas.

ent-RMCBoxMRE = caja de MRE (x12)
    .desc = Una caja de MRE. Nutritivas, pero nada deliciosas.
    .suffix = llena, UN

ent-RMCMRESPP = paquete de ración IRP de la SPP
    .desc = Una ración individual de comida compuesta sobre todo por una selección de conservas. Aunque pesa más, ha demostrado ser mucho más fiable.

ent-RMCMREWeYa = paquete de raciones de marca We-Ya
    .desc = Una ración más o menos coherente, destinada a colonos y a la seguridad corporativa, que contiene alimentos de calidad media y larga conservación. En la caja aparece el logotipo de Weyland-Yutani, rodeado por un lema: «WEYLAND-YUTANI. ALIMENTANDO EL FUTURO».

ent-RMCMREWeYaPMC = ración CFR de PMC
    .desc = Una ración de campaña. Sigue un formato parecido al de las MRE de la UNMC, pero emplea materiales y métodos de conservación caros, además de alimentos que tampoco son baratos; no se diferencia mucho de ir a un restaurante. Comiendo mundos mejores.

ent-RMCMRETSE = ración ORP del TSE
    .desc = Un paquete de raciones operativas. Sigue un formato parecido al de las MRE de la UNMC, pero emplea materiales y métodos de conservación caros, además de platos nada baratos de la cocina del TSE.

ent-RMCMRECLF = comida improvisada envuelta
    .desc = Alguna comida casera o recuperada; haces lo que puedes con los medios que tienes.

ent-RMCSurvivalRationSPP = ración de supervivencia de la SPP
    .desc = Un pequeño paquete comprimido que contiene una única porción de comida imposible de identificar.

ent-RMCBoxMRETSEEmpty = caja de ORP (x12)
    .desc = Una caja de ORP. ¡Riquísimas!
    .suffix = TSE

ent-RMCBoxMRETSE = caja de ORP (x12)
    .desc = Una caja de ORP. ¡Riquísimas!
    .suffix = llena, TSE

ent-RMCBoxMREWEYA = caja de paquetes de raciones de marca WEYA (x12)
    .desc = Una caja de paquetes de raciones Weyland-Yutani. Suelen encontrarse en colonias propiedad de la Compañía.
    .suffix = llena, WEYA

