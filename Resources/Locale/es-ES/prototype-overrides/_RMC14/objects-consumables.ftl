ent-CMMarinePreparedMealTofu = comida preparada (tofu)
    .desc = Aquí no sirven tofu, hippie chupahierbas. La banderita simboliza tu derrota.

# Comidas preparadas de la SPP

ent-RMCMarinePreparedMealSPPBanush = comida preparada (banush)
    .desc = Banush, un guiso ucraniano de harina de maíz, acompañado de albaricoques secos y un par de salchichas vienesas.

ent-RMCMarinePreparedMealSPPChowMein = comida preparada (chow mein)
    .desc = Chow mein con sucedáneo de gambas, dos rollitos de primavera un poco pasados, alguna clase de gachas y un pequeño cubo de tofu.

ent-RMCMarinePreparedMealSPPCuban = comida preparada (arroz cubano)
    .desc = Arroz cubano con trozos de huevo algo sosos, salsa de tomate, ensalada de patata y una galleta reseca.

ent-RMCMarinePreparedMealSPPFrankfurter = comida preparada (frankfurt)
    .desc = Una salchicha frankfurt grande y jugosa con puré de patatas, crujientes tortitas de patata y chucrut.

ent-RMCMarinePreparedMealSPPJiaozi = comida preparada (jiaozi)
    .desc = Cuatro jiaozi hervidos, salsa de soja y vinagre para mojar, pepinos rojos encurtidos y dos galletas de centeno.

ent-RMCMarinePreparedMealSPPLuncheon = comida preparada (fiambre)
    .desc = Dos porciones de arroz algo reseco, un cuadrado de alguna clase de fiambre, dos bastones de zanahoria y una barrita de «fruta».

ent-RMCMarinePreparedMealSPPMeatballs = comida preparada (albóndigas)
    .desc = Albóndigas Königsberger Klopse, una salsa cremosa, algo de espinaca y una porción de arroz. Es una de las mejores opciones entre las comidas preenvasadas y casi nunca hay existencias.

ent-RMCMarinePreparedMealSPPShrimp = comida preparada (gambas)
    .desc = Una torta grasienta de arroz con trozos de sucedáneo de gambas y aroma de huevo. Huele bastante raro. A un lado hay un rollito de primavera algo empapado.

ent-RMCMarinePreparedMealSPPWursts = comida preparada (wursts)
