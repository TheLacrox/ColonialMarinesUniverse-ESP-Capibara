ent-CMPosterSafetySusObject = póster de seguridad
    .desc = NO TE ACERQUES A OBJETOS SOSPECHOSOS. LLAMA A SEGURIDAD.

ent-CMPosterSafetyClean = póster de seguridad
    .desc = ¡LIMPIA LO QUE ENSUCIES! ESPACIO LIMPIO, MENTE DESPEJADA.

ent-CMPosterSafetyForeign = póster de seguridad
