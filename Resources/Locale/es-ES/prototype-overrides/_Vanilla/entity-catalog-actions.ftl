# Campos efectivos de prototipos localizados para es-ES.
# Los identificadores ent-* son contratos del motor y no se traducen.

ent-ActionAIViewLaws = ver leyes
    .desc = Ver las leyes que debes seguir.

ent-ActionActivateDeathAcidifier = activar acidificador de la muerte
    .desc = Activa tu acidificador letal, derritiéndote por completo a ti y a tu equipo

ent-ActionActivateDnaScramblerImplant = alterar ADN
    .desc = Cambia aleatoriamente tu nombre y apariencia.

ent-ActionActivateEmpImplant = activar EMP
    .desc = Provoca un pequeño pulso EMP a tu alrededor

ent-ActionActivateFreedomImplant = liberarse
    .desc = Activar tu implante de libertad te liberará de cualquier restricción en las manos

ent-ActionActivateHonkImplant = Honk
    .desc = Activa tu implante de bocina, que producirá el sonido característico del payaso.

ent-ActionActivateMicroBomb = activar microbomba
    .desc = Activa tu microbomba interna, destruyéndote por completo a ti y a tu equipo

ent-ActionActivateScramImplant = ¡Lárgate!
    .desc = Te teletransporta aleatoriamente a una gran distancia.

ent-ActionAnimalLayEgg = poner huevo
    .desc = Consume hambre para poner un huevo.

ent-ActionAnomalyPulse = pulso de anomalía
    .desc = Libera un pulso de energía de tu naturaleza anómala

ent-ActionChameleonController = controlar la ropa
    .desc = ¡Cambia todo tu atuendo rápidamente!

ent-ActionChangeVoiceMask = establecer nombre
    .desc = Cambia el nombre que oyen los demás por otro distinto.

ent-ActionClearNetworkLinkOverlays = borrar superposiciones de enlaces de red
    .desc = Borra las superposiciones de enlace de red.

ent-ActionCombatModeToggle = [color=red]modo de combate[/color]
    .desc = Entra en modo combate

ent-ActionCombatModeToggleOff = [color=red]modo de combate[/color]
    .desc = Entra en modo combate

ent-ActionConfigureMeleeSpeech = establecer grito de guerra
    .desc = ¡Configura un grito de guerra personalizado para cuando ataques!

ent-ActionCreateThrowingStar = crear estrella arrojadiza
    .desc = Canaliza la energía del traje para crear una estrella arrojadiza que inflige daño de resistencia adicional.

ent-ActionCritFakeDeath = muerte falsa
    .desc = Finge dar tu último suspiro mientras sigues con vida.

ent-ActionCritLastWords = decir últimas palabras
    .desc = Susurra tus últimas palabras a quien esté cerca y luego sucumbe a tu destino. Solo tienes 30 caracteres para hacerlo.

ent-ActionCritSuccumb = sucumbir
    .desc = Acepta tu destino.

ent-ActionEnergyKatanaDash = estocada de katana
    .desc = Teletranspórtate a cualquier lugar que puedas ver, siempre que tengas la Katana de Energía en la mano.

ent-ActionFireStarter = encender
    .desc = Prende fuego a los enemigos en un radio a tu alrededor.

ent-ActionGravityJump = saltar
    .desc = Al activar el sistema de propulsión avanzado, te impulsas una corta distancia en la dirección de tu mirada.

ent-ActionJumpToCore = saltar al núcleo
    .desc = Envía tu ojo de vuelta al núcleo.

ent-ActionMappingEraser = borrar entidad

ent-ActionMechCycleEquipment = ciclo
    .desc = Alterna el equipo actualmente seleccionado

ent-ActionMechEject = expulsar
    .desc = Expulsa al piloto del mech

ent-ActionMechOpenUI = panel de control
    .desc = Abre el panel de control del mecha

ent-ActionNinjaEmp = pulso EM
    .desc = Desactiva cualquier tecnología cercana con un pulso electromagnético.

ent-ActionOpenStorageImplant = alternar implante de almacenamiento
    .desc = Abre o cierra el implante de almacenamiento incrustado bajo tu piel

ent-ActionOpenUplinkImplant = abrir Uplink
    .desc = Abre el uplink del sindicato incrustado bajo tu piel

ent-ActionPolymorphJaunt = excursión etérea
    .desc = ¡Fúndete en el Plano Etéreo para una huida rápida!

ent-ActionPolymorphJauntII = excursión etérea II
    .desc = ¡Fúndete en el Plano Etéreo para una huida aún más rápida!

ent-ActionPolymorphJauntIII = excursión etérea III
    .desc = ¿Sigues siendo siquiera tangible?

ent-ActionPolymorphWizardRod = forma de barra
    .desc = ¡CLANG!

ent-ActionPolymorphWizardSpider = polimorfismo de araña
    .desc = Te transforma en una araña.

ent-ActionRecallKatana = recuperar katana
    .desc = Teletransporta hasta quien lo lleva puesto la Katana de Energía vinculada a este traje; el coste depende de la distancia.

ent-ActionRetractableItemArmBlade = cuchilla de brazo
    .desc = Desprende tu carne y transfórmala en una hoja de carne.

ent-ActionRevenantDefile = profanar
    .desc = Cuesta 30 de Esencia.

ent-ActionRevenantMalfunction = avería
    .desc = Cuesta 60 de Esencia.

ent-ActionRevenantOverloadLights = sobrecargar luces
    .desc = Cuesta 40 de Esencia.

ent-ActionRevenantShop = tienda
    .desc = Abre la tienda de habilidades.

ent-ActionRevertPolymorph = revertir
    .desc = Vuelve a tu forma original.

ent-ActionScream = gritar
    .desc = AAAAAAAAAAAAAAAAAAAAAAAAA

ent-ActionSelectBorgType = seleccionar tipo de cíborg

ent-ActionSericulture = tejer seda
    .desc = Teje un poco de seda para usar en manualidades.

ent-ActionSleep = dormir
    .desc = Vete a dormir.

ent-ActionSpiderWeb = telaraña
    .desc = Genera una telaraña que ralentiza a tu presa.

ent-ActionSurvCameraLights = alternar luces de la cámara
    .desc = Activa las luces de las cámaras de vigilancia cerca de donde estés viendo.

ent-ActionToggleBlock = bloquear
    .desc = Sube o baja tu escudo.

ent-ActionToggleEyes = abrir/cerrar ojos
    .desc = Cierra los ojos para proteger tus ojitos, o ábrelos para disfrutar de las bonitas luces.

ent-ActionToggleInternals = alternar internos
    .desc = Respira desde el tanque de gas equipado. También requiere una máscara respiratoria equipada.

ent-ActionToggleKnuckleDustersStun = alternar puño americano aturdidor
    .desc = Alterna la porra aturdidora integrada del guardapolvo.

ent-ActionToggleLight = alternar luz
    .desc = Enciende y apaga la luz.

ent-ActionToggleNinjaGloves = alternar guantes ninja
    .desc = Alterna todas las acciones del guante al hacer clic izquierdo. Incluye tu ganzúa de puertas, drenar energía, aturdir enemigos y hackear ciertos ordenadores.

ent-ActionToggleParamedicSiren = alternar sirena de paramédico
    .desc = Activa y desactiva la sirena de paramédico.

ent-ActionTogglePhaseCloak = capa de fase
    .desc = Alterna el manto de fase de tu traje. Ten cuidado: si te golpean, todas las habilidades se desactivan durante 5 segundos, ¡incluido tu manto!

ent-ActionToggleRootable = enraizable
    .desc = Empieza o deja de estar anclado al suelo.

ent-ActionToggleSuitPiece = alternar pieza del traje
    .desc = Recuerda equiparte las piezas importantes de tu traje antes de entrar en acción.

ent-ActionToggleWagging = cola meneante
    .desc = Empieza o deja de mover la cola.

ent-ActionTurnUndead = expulsar no muertos
    .desc = Sucumbe a tu infección y conviértete en zombi.

ent-ActionVendingThrow = dispensar objeto
    .desc = Dispensa aleatoriamente un objeto de tu stock.

ent-ActionViewLaws = ver leyes
    .desc = Ver las leyes que debes seguir.

ent-ActionWake = despertar
    .desc = Deja de dormir.

ent-DionaGibAction = ¡Destrízate!
    .desc = Se divide en 3 ninfas.

ent-DionaReformAction = reformarse
    .desc = Vuelve a formar una Diona completa.

ent-FakeMindShieldToggleAction = [color=green]alternar escudo mental falso[/color]
    .desc = Activa o desactiva la transmisión del implante de Escudo Mental falso
