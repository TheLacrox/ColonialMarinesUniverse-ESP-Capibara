# Campos efectivos de prototipos localizados para es-ES.
# Los identificadores ent-* son contratos del motor y no se traducen.

ent-DieObjective = morir una muerte gloriosa
    .desc = Muere.

ent-DragonSurviveObjective = sobrevivir
    .desc = Tienes que mantenerte con vida para conservar el control.

ent-EscapeShuttleObjective = escapar a centcomm con vida y sin restricciones.
    .desc = Uno de nuestros agentes encubiertos te informará cuando llegues. No te presentes esposado.

ent-EscapeThiefShuttleObjective = escapar a centcomm con vida y sin restricciones.
    .desc = No quieres que nadie descubra tus actividades ilegales, ¿verdad?

ent-KillRandomHeadObjective =
    .desc = Necesitamos que esta cabeza desaparezca y probablemente sepas por qué. Asegúrate de que no lleguen a CentComm, aunque estén muertos. Buena suerte, agente.

ent-KillRandomPersonObjective =
    .desc = Hazlo como quieras, solo asegúrate de que no salgan de la estación.

ent-MassArrestObjective = marcar a todos como buscados
    .desc = ¡Usa tus guantes para hackear una consola de registros criminales, marcando a toda la estación como buscada!

ent-NinjaSurviveObjective = sobrevivir
    .desc = No serías un buen ninja si murieras, ¿verdad?

ent-ParadoxCloneKillObjective = arreglar la paradoja espacio-temporal.
    .desc = Sustituye a tu original para arreglar la paradoja. Recuerda, tu misión es pasar desapercibido: ¡no mates a nadie más a menos que sea necesario!

ent-ParadoxCloneLivingObjective = escapar a centcomm con vida y sin restricciones.
    .desc = Vuelve a tu antigua vida.

ent-RandomTraitorAliveObjective =
    .desc = Identifícate bajo tu propio riesgo. Solo los necesitamos con vida.

ent-RandomTraitorProgressObjective =
    .desc = Identifícate bajo tu propio riesgo. Solo necesitamos que tengan éxito.

ent-SpiderChargeObjective =
    .desc = Esta bomba se puede detonar en una ubicación específica. ¡Ten en cuenta que no funcionará en ningún otro sitio!

ent-StealResearchObjective =
    .desc = Tus guantes se pueden usar para hackear un servidor de investigación y robar sus preciados datos. Si en ciencia han estado vagueando, tendrás que ponerte a trabajar.

ent-TerrorObjective = reportar una amenaza
    .desc = Usa tus guantes en una consola de comunicaciones para traer otra amenaza a la estación.

ent-WizardDemonstrateObjective = presumir
    .desc = ¡Dale a la estación una buena demostración de tus poderes!

ent-WizardSurviveObjective = sobrevivir
    .desc = ¡La Federación de Magos Espaciales quiere que vivas!
