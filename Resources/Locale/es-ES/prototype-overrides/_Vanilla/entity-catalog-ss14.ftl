# Campos efectivos de prototipos localizados para es-ES.
# Los identificadores ent-* son contratos del motor y no se traducen.

ent-ActionStartFishing = lanzar señuelo de pesca
    .desc = ¡Lanza el señuelo con la caña de pescar para atrapar algo!

ent-ActionStopFishing = caña de pescar de carrete
    .desc = Recoge tu caña de pescar para atraer un objeto enganchado, o deja de pescar.

ent-CrateFishingGoodies = caja de artículos de pesca
    .desc = Un par de cañas de pescar, un oso y un sombrero. ¡Todo lo que necesitas para pescar todos los peces de la estación!

ent-FishAlien = pez alienígena
    .desc = Parece bastante... Abductorio.

ent-FishAngler = pez rape
    .desc = Lo más aterrador que existe, después de los bingles.

ent-FishBass = pez róbalo
    .desc = Probablemente el pez más normal que existe. A menos que lo uses como bajo eléctrico.

ent-FishBingle = pez bingle
    .desc = bingle

ent-FishBlob = pez gota
    .desc = Por desgracia, esto no es una amenaza biológica de nivel 5.

ent-FishBlueFintuna = fintuna azul
    .desc = Te mira fijamente...

ent-FishBoyFisher = niño pescador
    .desc = Te gusta besar peces, ¿verdad?

ent-FishCat = pez gato
    .desc = Irónicamente, esto no se parece en nada a un gato. Y tampoco maúlla.

ent-FishGib = pez gib stick
    .desc = Mi cara cuando abro un regalo y me toca un gibstick:

ent-FishIan = pez de Ian
    .desc = Un Ian nacido en el agua, procedente del mar.

ent-FishMutant = pez mutante
    .desc = Un pez anómalo que parece haberse comido residuos nucleares.

ent-FishNukeDisk = pez disco nuclear
    .desc = Ejem, en realidad, es mala idea intentar meter un pez dentro de un dispositivo de explosión nuclear.

ent-FishNuker = pez de operativo nuclear
    .desc = Depredador del pez disco nuclear.

ent-FishPuffer = pez globo
    .desc = Es venenoso... de muchas maneras.

ent-FishSilver = pez plateado
    .desc = En realidad contiene plata.

ent-FishToxic = pez de residuos tóxicos
    .desc = Al mirar este pez, comprendes lo mala idea que fue permitir que se vertieran residuos nucleares en los ríos.

ent-FishTropical = pez payaso
    .desc = Este pez siempre está buscando algo... ¿O tal vez a alguien?

ent-FishTropicalClown = pez payaso payaso
    .desc = Eso es casi con toda seguridad algún tipo de broma.

ent-FishTropicalSun = pez sol tropical
    .desc = ¿Probablemente miró al sol demasiado tiempo...?

ent-FishingLure = señuelo de pesca
    .desc = pez, ven aquí

ent-FishingLureMakeshift = señuelo de pesca
    .desc = pez, ven aquí

ent-FishingRod = caña de pescar
    .desc = ¡Es hora de ir a pescar!

ent-FishingRodGolden = caña de pescar dorada
    .desc = Por fin, has pescado 250 peces. Aquí tienes tu trofeo.

ent-FishingRodGoon = caña de pescar
    .desc = ¡Es hora de ir a pescar!
    .suffix = Goon

ent-FishingRodMakeshift = caña de pescar improvisada
    .desc = Probablemente sería difícil pescar algo con eso.

ent-FishingSpotWater = ondas sospechosas
    .desc = Algo flota aquí...
