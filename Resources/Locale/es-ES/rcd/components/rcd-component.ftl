
### Interfaz

rcd-component-examine-mode-details = Está configurado en el modo «{$mode}».
rcd-component-examine-build-details = Está configurado para construir {MAKEPLURAL($name)}.


### Mensajes de interacción

# Cambio de modo
rcd-component-change-mode = El RCD ahora está configurado en el modo «{$mode}».
rcd-component-change-build-mode = El RCD ahora está configurado para construir {MAKEPLURAL($name)}.

# Cantidad de munición
rcd-component-no-ammo-message = ¡El RCD se ha quedado sin cargas!
rcd-component-insufficient-ammo-message = ¡Al RCD no le quedan suficientes cargas!

# Desconstrucción
rcd-component-tile-indestructible-message = ¡Esa casilla no puede destruirse!
rcd-component-deconstruct-target-not-on-whitelist-message = ¡No puedes desconstruir eso!
rcd-component-nothing-to-deconstruct-message = ¡No hay nada que desconstruir!
rcd-component-tile-obstructed-message = ¡No puedes desconstruir casillas cuando tienen algo encima!

# Construcción
rcd-component-no-valid-grid = ¡Estás demasiado lejos en el espacio abierto para construir aquí!
rcd-component-must-build-on-empty-tile-message = ¡Aquí ya hay unos cimientos!
rcd-component-cannot-build-on-empty-tile-message = ¡No puedes construir eso sin unos cimientos!
rcd-component-must-build-on-subfloor-message = ¡Solo puedes construir eso sobre un subsuelo expuesto!
rcd-component-cannot-build-on-subfloor-message = ¡No puedes construir eso sobre un subsuelo expuesto!
rcd-component-cannot-build-on-occupied-tile-message = ¡No puedes construir aquí; el espacio ya está ocupado!
rcd-component-cannot-build-identical-tile = ¡Esa casilla ya existe aquí!


