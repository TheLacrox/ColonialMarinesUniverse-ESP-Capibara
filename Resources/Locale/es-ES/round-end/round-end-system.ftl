## RoundEndSystem

round-end-system-shuttle-called-announcement = Se ha enviado un transbordador de emergencia. Tiempo estimado: {$time} {$units}.
round-end-system-shuttle-already-called-announcement = Ya se ha enviado un transbordador de emergencia.
round-end-system-shuttle-auto-called-announcement = Se ha enviado automáticamente un transbordador para el cambio de turno de la tripulación. Tiempo estimado: {$time} {$units}. Cancela el transbordador para prolongar el turno.
round-end-system-shuttle-recalled-announcement = Se ha cancelado el transbordador de emergencia.
round-end-system-shuttle-sender-announcement = Estación
round-end-system-round-restart-eta-announcement = Reiniciando la ronda en {$time} {$units}...

eta-units-minutes = minutos
eta-units-seconds = segundos
