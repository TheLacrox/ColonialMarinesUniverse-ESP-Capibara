# FTLdiskburner
cmd-ftldisk-desc = Crea un disco de coordenadas FTL para viajar al mapa donde está o al que pertenece el ID de entidad indicado
cmd-ftldisk-help = ftldisk [ID de entidad]

cmd-ftldisk-no-transform = ¡La entidad {$destination} no tiene Transform Component!
cmd-ftldisk-no-map = ¡La entidad {$destination} no tiene mapa!
cmd-ftldisk-no-map-comp = La entidad {$destination} está de algún modo en el mapa {$map}, que no tiene componente de mapa.
cmd-ftldisk-map-not-init = ¡La entidad {$destination} está en el mapa {$map}, que no se ha inicializado! Comprueba que sea seguro y después inicializa primero el mapa; de lo contrario, los jugadores quedarán inmovilizados.
cmd-ftldisk-map-paused = ¡La entidad {$desintation} está en el mapa {$map}, que está en pausa! Reactiva primero el mapa; de lo contrario, los jugadores quedarán inmovilizados.
cmd-ftldisk-planet = La entidad {$desintation} está en el mapa planetario {$map} y necesitará un punto FTL. Es posible que ya exista.
cmd-ftldisk-already-dest-not-enabled = La entidad {$destination} está en el mapa {$map}, que ya tiene un FTLDestinationComponent, pero no está activado. Actívalo manualmente por seguridad.
cmd-ftldisk-requires-ftl-point = ¡La entidad {$destination} está en el mapa {$map}, que necesita un punto FTL para viajar hasta él! Es posible que ya exista.

cmd-ftldisk-hint = ID de red del mapa
