thief-backpack-window-title = Equipo de ladrón

thief-backpack-window-description =
    En el interior están tus herramientas de trabajo, que se disolverán cuando termines.
    Elige {$maxCount} {$maxCount ->
        [1] conjunto distinto
        *[other] conjuntos distintos
    } de la lista.

thief-backpack-window-selected = Equipos seleccionados: ({$selectedCount}/{$maxCount})

thief-backpack-window-approve-button = Confirmar
thief-backpack-button-select = Seleccionar [  ]
thief-backpack-button-deselect = Seleccionar [X]

# Conjuntos

thief-backpack-category-chameleon-name = Equipo camaleón
thief-backpack-category-chameleon-description =
    Eres todo el mundo y nadie; dominas el arte del disfraz.
    Incluye un conjunto completo de ropa camaleónica,
    un proyector camaleónico y una identificación de agente.
    Disfrázate de cualquier persona o cosa.

thief-backpack-category-tools-name = Equipo de asalto
thief-backpack-category-tools-description =
    ¿Qué es ese ruido? Un poco de C4 llamando a la puerta.
    ¡Ningún obstáculo podrá detenerte!
    Incluye dos C4, una multiherramienta, un señalizador remoto, unas mandíbulas de rescate,
    un soldador avanzado, gafas de ingeniería y guantes aislantes.

thief-backpack-category-chemistry-name = Equipo anatómico
thief-backpack-category-chemistry-description =
    Has alcanzado el máximo rendimiento físico... con un poco de ayuda.
    Incluye un implantador de almacenamiento, un implantador mezclador de ADN,
    un frasco de efedrina, una jeringa, una coctelera vacía y jabón omega.

thief-backpack-category-syndie-name = Equipo del Sindicato
thief-backpack-category-syndie-description =
    ¿Recuerdos de un pasado repudiado o robados a un agente descuidado?
    Has hecho algunos contactos. Whiskey, echo...
    Incluye una Emag, un rompedor de accesos, cigarrillos Interdyne, una palabra clave del Sindicato,
    un inhibidor de radio, un encendedor y unos extraños cristales rojos.

thief-backpack-category-sleeper-name = Equipo somnífero
thief-backpack-category-sleeper-description =
    Hasta que cerremos los ojos para siempre, usa tus recetas ilegales
    para mantener dormidos a los demás.
    Incluye un depósito de óxido nitroso somnífero, dos frascos de nocturina
    y una hipopluma.

thief-backpack-category-communicator-name = Equipo de comunicador
thief-backpack-category-communicator-description =
    El dinero es poder y los secretos son dinero. Usa tu labia
    y tu riqueza para subvertir la estación.
    Incluye una llave maestra para todos los canales, un bolígrafo CyberSun,
    una máscara camaleónica de voz y 20 000 spesos dentro de un maletín.

thief-backpack-category-smuggler-name = Equipo de contrabandista
thief-backpack-category-smuggler-description =
    Todo ladrón necesita un lugar oscuro donde ocultar sus mercancías.
    No olvides vincular tu Fulton.
    Incluye una baliza Fulton, 10 Fulton, 3 granadas de humo
    y una caja invisible para ocultar botín valioso.
