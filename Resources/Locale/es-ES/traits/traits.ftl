trait-blindness-name = Ceguera
trait-blindness-desc = Eres legalmente ciego y no puedes ver con claridad más allá de unos metros.

trait-poor-vision-name = Miopía
trait-poor-vision-desc = Tus ojos ya no son lo que eran y te cuesta ver de lejos sin gafas correctoras.

trait-narcolepsy-name = Narcolepsia
trait-narcolepsy-desc = Te duermes de forma aleatoria.

trait-pacifist-name = Pacifista
trait-pacifist-desc = No puedes atacar ni hacer daño a ningún ser vivo.

permanent-blindness-trait-examined = [color=lightblue]{CAPITALIZE(POSS-ADJ($target, "plural"))} ojos tienen una mirada vidriosa y desenfocada. Parece que {SUBJECT($target)} apenas puede verte, si es que puede.[/color]

trait-lightweight-name = Poca tolerancia al alcohol
trait-lightweight-desc = El alcohol tiene un efecto más intenso sobre ti.

trait-monochromacy-name = Monocromatismo
trait-monochromacy-desc = No percibes ningún color; todo lo que ves abarca únicamente tonos entre el negro y el blanco.

trait-muted-name = Mudez
trait-muted-desc = No puedes hablar.

trait-paracusia-name = Paracusia
trait-paracusia-desc = Oyes sonidos que en realidad no existen.

trait-unrevivable-name = No reanimable
trait-unrevivable-desc = Los desfibriladores no pueden reanimarte.

trait-pirate-accent-name = Acento pirata
trait-pirate-accent-desc = ¡No puedes dejar de hablar como un pirata!

trait-accentless-name = Sin acento racial
trait-accentless-desc = No tienes el acento habitual de tu especie.

trait-frontal-lisp-name = Ceceo frontal
trait-frontal-lisp-desc = Hablas con un ceceo marcado.

trait-socialanxiety-name = Tartamudez
trait-socialanxiety-desc = Hablas con tartamudez.

trait-socialanxietyheavy-name = Tartamudez intensa
trait-socialanxietyheavy-desc = Tartamudeas mucho y es posible que tus frases queden interrumpidas.

trait-southern-name = Acento sureño
trait-southern-desc = Tienes una manera distinta de hablá'.

trait-snoring-name = Ronquidos
trait-snoring-desc = Roncas mientras duermes.

trait-liar-name = Mentiroso patológico
trait-liar-desc = Apenas eres capaz de decir la verdad. A veces mientes de todos modos.

trait-cowboy-name = Acento de vaquero
trait-cowboy-desc = ¡Hablas con un marcado acento de vaquero!

trait-german-name = Acento alemán
trait-german-desc = Parece que procedes de la Alemania espacial.

trait-italian-name = Acento italiano
trait-italian-desc = ¡Mamma mia! ¡Parece que viviste en la Italia espacial!

trait-french-name = Acento francés
trait-french-desc = Tu acento parece tener cierto «je ne sais quoi».

trait-spanish-name = Acento español
trait-spanish-desc = Hablas con un marcado acento español.

trait-painnumbness-name = Insensibilidad al dolor
trait-painnumbness-desc = No puedes sentir dolor y no sabes hasta qué punto estás herido.
