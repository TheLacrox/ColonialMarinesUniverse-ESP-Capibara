### Interfaz

# Se muestra al examinar la ventana. Cada entrada representa su estado.
comp-window-damaged-1 = Parece completamente intacta.
comp-window-damaged-2 = Tiene algunos arañazos.
comp-window-damaged-3 = Tiene algunas grietas pequeñas.
comp-window-damaged-4 = [color=yellow]Varias grietas grandes recorren su superficie.[/color]
comp-window-damaged-5 = [color=orange]Tiene grietas profundas que atraviesan varias capas.[/color]
comp-window-damaged-6 = [color=red]Está muy agrietada y a punto de hacerse añicos.[/color]

### Mensajes de interacción

# Se muestra al golpear una ventana
comp-window-knock = *toc toc*
