      <Box HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="2">
        Puesta en peligro
      </Box>
    </ColorBox>
    <ColorBox>
      <Box HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="2">
        Ponerse a uno mismo o a otras personas en peligro de forma temeraria, ya sea por acción directa o por omisión.
      </Box>
    </ColorBox>
    <ColorBox>
      <Box HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="2">
        Abarca accidentes industriales, negligencia industrial, experimentación con uno mismo e incluso negligencia médica.
      </Box>
    </ColorBox>
    <ColorBox>
      <Box HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="2">
        2-05
      </Box>
    </ColorBox>
